#!/bin/bash
# Recolour the Starship prompt to the theme just applied.
#
# ~/.config/starship.toml uses exact hex colours (the accent pill needs a fixed
# background/foreground pair), and hex colours never follow the terminal's
# palette swap. So the real config lives as a template with {{ key }}
# placeholders, and this hook renders it with the current theme's colors.toml.
# Starship rereads its config on every prompt: open shells pick up the new
# colours on their next prompt, no restart needed.
set -u

TEMPLATE="$HOME/.config/starship/starship.toml.tpl"
TARGET="${STARSHIP_CONFIG:-$HOME/.config/starship.toml}"

[[ -f $TEMPLATE ]] || exit 0
colors=$(omarchy-theme-color --all 2>/dev/null) || exit 0
[[ -n $colors ]] || exit 0

tmp=$(mktemp "${TARGET}.XXXXXX") || exit 0
# Unknown keys are left as written, so a typo shows up in the output instead of
# silently vanishing.
if awk -F'\t' '
  NR == FNR { c[$1] = $2; next }
  {
    line = $0; out = ""
    while (match(line, /\{\{[ \t]*[A-Za-z0-9_]+[ \t]*\}\}/)) {
      tok = substr(line, RSTART, RLENGTH)
      key = tok; gsub(/[{} \t]/, "", key)
      out = out substr(line, 1, RSTART - 1) ((key in c) ? c[key] : tok)
      line = substr(line, RSTART + RLENGTH)
    }
    print out line
  }' <(printf '%s\n' "$colors") "$TEMPLATE" >"$tmp"; then
  chmod 644 "$tmp" && mv -f "$tmp" "$TARGET"
else
  rm -f "$tmp"
fi
exit 0
