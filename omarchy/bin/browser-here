#!/usr/bin/env bash
#
# browser-here <url>
#
# Open a URL in the default browser on the same Hyprland workspace as the
# terminal this runs in (for example Claude Code opening a Lavish page),
# instead of wherever you happen to be:
#
#   - when you are on that workspace already, the page opens there in front;
#   - otherwise it opens in a new browser window placed on that workspace
#     without taking your focus, and a notification says where it is
#     ("Lavish is ready · main screen · workspace 2") with a Go there button.
#
# A new window rather than a tab in a browser window already there: Chromium
# puts a new tab in the window it last saw active, which is not reliably the
# one on that workspace, so tabs landed wherever you were.
#
# The terminal is found by walking up the process tree to a window's PID
# (inside tmux, from the tmux client's PID). If no terminal window is found,
# the active workspace is used.
set -uo pipefail

url=${1:-}
[[ -n $url ]] || { echo "usage: browser-here <url>" >&2; exit 2; }

# The default browser's command, as Omarchy's own launcher finds it.
desktop=$(omarchy-cmd-default-browser 2>/dev/null || xdg-settings get default-web-browser)
browser=""
IFS=: read -ra dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
for d in "${dirs[@]}"; do
  [[ -f $d/applications/$desktop ]] || continue
  browser=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$d/applications/$desktop" | head -1)
  break
done
[[ -n $browser ]] || browser=chromium
# Its windows' class: chromium, google-chrome, brave-browser, firefox, ...
# (Omarchy's web apps run as chrome-<site> windows and are not matched.)
class=$(basename "$browser"); class=${class%-stable}

# The workspace of the terminal this runs in.
start=$$
[[ -n ${TMUX:-} ]] && start=$(tmux display-message -p '#{client_pid}' 2>/dev/null || echo $$)
pids=()
p=$start
while [[ -n $p && $p -gt 1 ]]; do
  pids+=("$p")
  p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
done
clients=$(hyprctl clients -j)
ws=$(jq -r --argjson pids "[$(IFS=,; echo "${pids[*]}")]" \
  'first(.[] | select(.pid as $p | $pids | index($p))) | .workspace.id // empty' <<<"$clients")
[[ -n $ws ]] || ws=$(hyprctl activeworkspace -j | jq -r .id)

dispatch() { hyprctl dispatch "$1" >/dev/null 2>&1; }
launch() { # detached, so the browser outlives this shell
  systemd-run --user --quiet --collect --unit="browser-here-$(date +%s%N)" \
    --property=StandardOutput=null --property=StandardError=null \
    uwsm-app -- "$browser" "$@"
}

# Where you are now, to stay there.
active_ws=$(hyprctl activeworkspace -j | jq -r .id)
active_win=$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty')

# You are on that workspace: open it in front, as a tab of a browser window
# there when there is one, or a new window.
if [[ $ws == "$active_ws" ]]; then
  win=$(jq -r --arg c "$class" --argjson ws "$ws" \
    '[.[] | select(.class == $c and .workspace.id == $ws)] | sort_by(.focusHistoryID) | first.address // empty' <<<"$clients")
  if [[ -n $win ]]; then
    dispatch "hl.dsp.focus({ window = \"address:$win\" })"
    sleep 0.2
    launch "$url"
  else
    launch --new-window "$url"
  fi
  exit 0
fi

# Elsewhere: a new window, moved to that workspace the moment it appears, and
# your focus put back where it was.
before=$(jq -r --arg c "$class" '[.[] | select(.class == $c) | .address] | join(" ")' <<<"$clients")
launch --new-window "$url"
new=""
for _ in $(seq 1 150); do
  sleep 0.03
  new=$(hyprctl clients -j | jq -r --arg c "$class" --arg before " $before " \
    'first(.[] | select(.class == $c) | .address as $a | select($before | contains(" " + $a + " ") | not) | $a) // empty')
  [[ -n $new ]] && break
done
[[ -n $new ]] || exit 0
dispatch "hl.dsp.window.move({ workspace = \"$ws\", follow = false, window = \"address:$new\" })"
if [[ -n $active_win ]]; then
  dispatch "hl.dsp.focus({ window = \"address:$active_win\" })"
else
  dispatch "hl.dsp.focus({ workspace = \"$active_ws\" })"
fi

# Say where it is, with a way to go there.
monitor=$(hyprctl clients -j | jq -r --arg a "$new" 'first(.[] | select(.address == $a)) | .monitor // empty')
mon_name=$(hyprctl monitors -j | jq -r --argjson id "${monitor:-0}" 'first(.[] | select(.id == $id)) | .name // empty')
case $mon_name in
  HDMI-A-1) where="main screen" ;;
  DP-2) where="right screen" ;;
  eDP-1) where="laptop" ;;
  *) where=${mon_name:-another screen} ;;
esac
slot=$(( (ws - 1) % 10 + 1 ))
title="Page ready"
[[ $url == *127.0.0.1*session* || $url == *localhost*session* ]] && title="Lavish is ready"
omarchy-notification-send -g "󰖟" "$title" "$where · workspace $slot" \
  --action "Go there" hyprctl dispatch "hl.dsp.focus({ window = \"address:$new\" })" >/dev/null 2>&1 &
exit 0
