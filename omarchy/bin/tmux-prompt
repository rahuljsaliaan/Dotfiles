#!/usr/bin/env bash
#
# Floating input for tmux, shown in a display-popup (see ~/.config/tmux/tmux.conf)
# instead of tmux's command prompt. tmux's prompt takes over the whole status
# line while you type, hiding the session name; a popup leaves the status line
# alone. fzf is the input box: Enter accepts, Esc cancels.
#
#   tmux-prompt window    rename the current window   (prefix , / prefix r)
#   tmux-prompt session   rename the current session  (prefix $ / prefix R)
#   tmux-prompt command   run a tmux command          (prefix :)
#
set -uo pipefail

mode="${1:-command}"
case $mode in
  window)  initial="$(tmux display-message -p '#W')" ;;
  session) initial="$(tmux display-message -p '#S')" ;;
  command) initial="" ;;
  *) echo "usage: tmux-prompt window|session|command" >&2; exit 2 ;;
esac

# An input line, not a picker: no items, so fzf shows only the query. Colours
# are palette names, so they follow the terminal theme.
out="$(fzf --print-query --query "$initial" --prompt '❯ ' \
  --layout reverse --height 100% --no-info --no-separator --no-scrollbar \
  --pointer '' --marker '' --border none \
  --color 'bg:-1,bg+:-1,gutter:-1,prompt:blue,query:bright-white:bold,disabled:bright-white' \
  < /dev/null)"
[[ $? -eq 130 ]] && exit 0   # Esc / Ctrl-C: cancelled, change nothing
value="$(printf '%s\n' "$out" | head -n 1)"
[[ -z ${value//[[:space:]]/} ]] && exit 0

case $mode in
  window)  tmux rename-window -- "$value" ;;
  session) tmux rename-session -- "$value" ;;
  command)
    # Parsed exactly as tmux parses a command line; any error is shown briefly.
    if ! err="$(printf '%s\n' "$value" | tmux source-file - 2>&1)" || [[ -n $err ]]; then
      [[ -n $err ]] && tmux display-message -- "$err"
    fi
    ;;
esac
