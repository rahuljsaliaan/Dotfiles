#!/usr/bin/env python3
"""crew-deck - a live, read-only view of Firstmate's workers in the browser.

Usage:
  crew-deck           start the local server if it is not running, then open the page
  crew-deck serve     run the server in the foreground
  crew-deck stop      stop the background server
  crew-deck --json    print one snapshot and exit

It reads Firstmate's own fleet snapshot (bin/fm-fleet-view.sh --json), each
worker's tmux screen and the memory its processes use. It only reads: it never
steers, stops or merges anything. The page takes its colours and font from the
current Omarchy theme (colors.toml) on every refresh, so a theme switch shows
up live. The server listens on 127.0.0.1 only.

Environment: FM_HOME (default ~/Repository/firstmate), CREW_DECK_PORT (default 4399).
"""
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time
import tomllib
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

HOME = Path.home()
FM = Path(os.environ.get("FM_HOME", HOME / "Repository/firstmate"))
PORT = int(os.environ.get("CREW_DECK_PORT", "4399"))
URL = f"http://127.0.0.1:{PORT}/"
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state"))
COLORS = STATE / "omarchy/current/theme/colors.toml"
RUN = STATE / "crew-deck"
PIDFILE = RUN / "server.pid"
CACHE_SECONDS = 2.5

TOOL_LINE = re.compile(
    r"^(Bash|Read|Write|Update|Edit|MultiEdit|Search|Grep|Glob|Task|Agent|Fetch|Web\w*|List|Skill|"
    r"Reading|Writing|Searching|Running|Ran|Listing|Updating|Editing|Wrote|Read \d|Called|Calling)\b"
)
CHROME = re.compile(r"^[\s─━│╭╮╰╯▐▛▜▌▝▘█▀▙▟]*$|^\s*(⏵⏵|󰚩|❯\s*$)|esc to interrupt|shift\+tab to cycle|Update available")


def sh(args, timeout=15, env=None):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout, env=env)
        return r.stdout if r.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


# ---------------------------------------------------------------- theme
_font = None


def theme():
    global _font
    try:
        with open(COLORS, "rb") as f:
            colors = {k: v for k, v in tomllib.load(f).items() if isinstance(v, str)}
    except (OSError, tomllib.TOMLDecodeError):
        colors = {}
    if _font is None:
        _font = sh(["omarchy-font-current"], timeout=3).strip() or "monospace"
    name = ""
    try:
        name = (STATE / "omarchy/current/theme.name").read_text().strip()
    except OSError:
        name = sh(["omarchy-theme-current"], timeout=3).strip()
    return {"colors": colors, "font": _font, "name": name}


# ---------------------------------------------------------------- memory
def meminfo():
    vals = {}
    try:
        for line in open("/proc/meminfo"):
            k, v = line.split(":", 1)
            vals[k] = int(v.split()[0]) * 1024
    except OSError:
        return None
    return {
        "total": vals.get("MemTotal", 0),
        "used": vals.get("MemTotal", 0) - vals.get("MemAvailable", 0),
        "swap_total": vals.get("SwapTotal", 0),
        "swap_used": vals.get("SwapTotal", 0) - vals.get("SwapFree", 0),
    }


def process_table():
    """pid -> (ppid, rss bytes) for every readable process."""
    page = os.sysconf("SC_PAGE_SIZE")
    table = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            stat = open(f"/proc/{d}/stat").read()
            rest = stat[stat.rindex(")") + 2:].split()
            table[int(d)] = (int(rest[1]), int(rest[21]) * page)
        except (OSError, ValueError, IndexError):
            pass
    return table


def tree_rss(root, table):
    children = {}
    for pid, (ppid, _) in table.items():
        children.setdefault(ppid, []).append(pid)
    total, stack = 0, [root]
    while stack:
        pid = stack.pop()
        total += table.get(pid, (0, 0))[1]
        stack.extend(children.get(pid, []))
    return total


# ---------------------------------------------------------------- screens
def screen(target):
    raw = sh(["tmux", "capture-pane", "-p", "-J", "-t", target, "-S", "-120"], timeout=5)
    lines = [l.rstrip() for l in raw.splitlines()]
    busy = any("esc to interrupt" in l for l in lines[-8:])
    kept = [l for l in lines if l.strip() and not CHROME.search(l)]
    return kept, busy


def doing_now(lines):
    """The worker's latest plain-language line: the last '●' paragraph that is
    prose rather than a tool call."""
    blocks, cur = [], None
    for l in lines:
        if l.startswith("● "):
            cur = [l[2:].strip()]
            blocks.append(cur)
        elif cur is not None and l.startswith("  ") and not l.lstrip().startswith("⎿"):
            if re.match(r"^\s*[✻✽✶✳✢·*]\s", l):
                cur = None
            else:
                cur.append(l.strip())
        else:
            cur = None
    for b in reversed(blocks):
        text = " ".join(b)
        if not TOOL_LINE.match(text):
            text = re.sub(r"\s+", " ", text).strip()
            return text[:480] + ("…" if len(text) > 480 else "")
    return ""


def pane_pid(target):
    out = sh(["tmux", "display-message", "-p", "-t", target, "#{pane_pid}"], timeout=3).strip()
    return int(out) if out.isdigit() else None


# ---------------------------------------------------------------- deck
def badge(t, held, last):
    cs = t.get("current_state") or {}
    state = cs.get("state") or "unknown"
    detail = (cs.get("detail") or "").lower()
    pr = (t.get("pr") or {}).get("url")
    last_state = (last or {}).get("state")
    last_note = ((last or {}).get("note") or "").lower()
    if held:
        return "you", "Waiting on you"
    if (t.get("endpoint") or {}).get("exists") is False:
        return "bad", "Stopped"
    if state == "failed":
        return "bad", "Failed"
    if state == "blocked":
        return "bad", "Blocked"
    if state == "parked":
        return "decide", "Decision in progress"
    if state == "done" or (pr and last_state == "done"):
        return "ready", "PR ready"
    if "fix" in detail or (last_state == "paused" and "fix" in last_note):
        return "fix", "Fixing review findings"
    if "validating" in detail or "ci" in detail.split():
        return "check", "Reviewing & testing"
    if state == "paused":
        return "wait", "Waiting"
    if state == "working":
        return "work", "Working"
    return "muted", "Unknown"


def title_of(t, record):
    title = (record or {}).get("title") or t.get("id")
    repo = (record or {}).get("repo") or ""
    if repo and title.lower().startswith(repo.lower() + ":"):
        title = title[len(repo) + 1:].strip()
    return title[:1].upper() + title[1:], repo


def build():
    snap = sh([str(FM / "bin/fm-fleet-view.sh"), "--json"], timeout=30, env={**os.environ, "FM_HOME": str(FM)})
    try:
        snap = json.loads(snap)
    except ValueError:
        snap = None
    now = time.time()
    deck = {"generated": now, "theme": theme(), "memory": meminfo(), "ok": snap is not None,
            "home": str(FM), "workers": [], "waiting": [], "ready": []}
    if not snap:
        return deck
    records = {r.get("id"): r for r in (snap.get("backlog") or {}).get("records", [])}
    table = process_table()
    for r in records.values():
        if r.get("hold_kind") == "captain" and r.get("state") != "done":
            title, repo = title_of({"id": r.get("id")}, r)
            deck["waiting"].append({"id": r.get("id"), "title": title, "repo": repo,
                                    "reason": r.get("hold_reason") or ""})
    for t in snap.get("tasks", []):
        if t.get("kind") == "secondmate":
            continue
        rec = records.get(t.get("id")) or t.get("backlog") or {}
        held = rec.get("hold_kind") == "captain"
        last = ((t.get("paths") or {}).get("status_log") or {}).get("last_event")
        kind, label = badge(t, held, last)
        title, repo = title_of(t, rec)
        target = (t.get("endpoint") or {}).get("target")
        lines, busy, rss = [], False, None
        if t.get("backend") == "tmux" and target and (t.get("endpoint") or {}).get("exists"):
            lines, busy = screen(target)
            pid = pane_pid(target)
            rss = tree_rss(pid, table) if pid else None
        started = None
        m = re.match(r"s(\d+)\.", t.get("spawn_gen") or "")
        if m:
            started = int(m.group(1))
        pr = (t.get("pr") or {}).get("url")
        w = {"id": t.get("id"), "title": title, "repo": repo, "badge": kind, "label": label,
             "doing": doing_now(lines), "busy": busy, "started": started, "rss": rss, "pr": pr,
             "last_age": (last or {}).get("age_seconds"), "screen": lines[-18:],
             "branch": t.get("branch")}
        deck["workers"].append(w)
        if kind == "ready" and pr:
            deck["ready"].append({"id": w["id"], "title": title, "repo": repo, "pr": pr})
    order = {"you": 0, "bad": 1, "ready": 2, "decide": 3, "fix": 4, "check": 5, "work": 6, "wait": 7, "muted": 8}
    deck["workers"].sort(key=lambda w: (order.get(w["badge"], 9), -(w["started"] or 0)))
    return deck


_cache = {"at": 0.0, "deck": None}
_lock = threading.Lock()


def cached_deck():
    with _lock:
        if _cache["deck"] is None or time.time() - _cache["at"] > CACHE_SECONDS:
            _cache["deck"] = build()
            _cache["at"] = time.time()
        return _cache["deck"]


# ---------------------------------------------------------------- server
class Handler(BaseHTTPRequestHandler):
    def _send(self, code, body, ctype):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path == "/":
            self._send(200, PAGE, "text/html; charset=utf-8")
        elif path == "/api/deck":
            self._send(200, json.dumps(cached_deck()), "application/json")
        elif path == "/api/ping":
            self._send(200, json.dumps({"app": "crew-deck"}), "application/json")
        else:
            self._send(404, "not found", "text/plain")

    def log_message(self, *args):
        pass


def serve():
    RUN.mkdir(parents=True, exist_ok=True)
    PIDFILE.write_text(str(os.getpid()))
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    signal.signal(signal.SIGTERM, lambda *_: (srv.server_close(), sys.exit(0)))
    try:
        srv.serve_forever()
    finally:
        try:
            if PIDFILE.read_text().strip() == str(os.getpid()):
                PIDFILE.unlink()
        except OSError:
            pass


def alive():
    try:
        with urllib.request.urlopen(URL + "api/ping", timeout=1) as r:
            return json.load(r).get("app") == "crew-deck"
    except Exception:
        return False


def start_background():
    RUN.mkdir(parents=True, exist_ok=True)
    log = open(RUN / "server.log", "ab")
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "serve"], stdin=subprocess.DEVNULL,
                     stdout=log, stderr=log, start_new_session=True, close_fds=True)
    for _ in range(50):
        if alive():
            return True
        time.sleep(0.1)
    return False


def stop():
    try:
        pid = int(PIDFILE.read_text().strip())
        if b"crew-deck" not in Path(f"/proc/{pid}/cmdline").read_bytes():
            raise ValueError
    except (OSError, ValueError):
        print("crew-deck: no server running")
        return
    os.kill(pid, signal.SIGTERM)
    print(f"crew-deck: stopped server {pid}")


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg in ("-h", "--help"):
        print(__doc__.strip())
    elif arg == "serve":
        serve()
    elif arg == "stop":
        stop()
    elif arg == "--json":
        print(json.dumps(build(), indent=1))
    elif arg == "":
        if not alive() and not start_background():
            sys.exit(f"crew-deck: the server did not start; see {RUN / 'server.log'}")
        opener = "browser-here" if sh(["sh", "-c", "command -v browser-here"]).strip() else "xdg-open"
        subprocess.Popen([opener, URL], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        print(URL)
    else:
        sys.exit(f"crew-deck: unknown argument {arg!r}; see crew-deck --help")


