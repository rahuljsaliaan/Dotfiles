const $ = (id) => document.getElementById(id);
const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
const linkify = (s) => esc(s).replace(/https?:\/\/[^\s<>"']+[^\s<>"'.,;:)]/g, (u) => `<a href="${u}" target="_blank" rel="noopener">${u}</a>`);
const store = { get(k) { try { return localStorage.getItem(k); } catch { return null; } }, set(k, v) { try { localStorage.setItem(k, v); } catch {} } };
const VARS = { background: "--bg", dark_background: "--bg-dark", darker_background: "--bg-darker", lighter_background: "--bg-light",
  foreground: "--fg", dark_foreground: "--fg-dim", bright_foreground: "--fg-bright", muted: "--muted", accent: "--accent",
  selection: "--selection", red: "--red", yellow: "--yellow", orange: "--orange", green: "--green", cyan: "--cyan", blue: "--blue", magenta: "--magenta" };
let deck = null, sel = store.get("crew-deck-sel"), tab = store.get("crew-deck-tab") || "terminal", themeKey = "", lastOk = 0, chatKey = "", pending = [];
let selBoard = store.get("crew-deck-board") || null;
let fmTab = store.get("crew-deck-fmtab") || "terminal";
let selNeed = store.get("crew-deck-need") || null, needKey = "", choice = {}, noteText = {};
const sentMap = () => { try { return JSON.parse(store.get("crew-deck-sent") || "{}"); } catch { return {}; } };
const FM_ID = "__firstmate__";
const STATUS = { open: "open for review", feedback: "your feedback is queued", ended: "ended" };
const liveBoards = () => (deck.boards || []).filter((b) => b.status !== "ended");
const ownerLabel = (b) => b.owner;

function applyTheme(t) {
  const key = JSON.stringify(t || {});
  if (!t || key === themeKey) return;
  themeKey = key;
  const r = document.documentElement.style;
  for (const [k, v] of Object.entries(VARS)) if (t.colors?.[k]) r.setProperty(v, t.colors[k]);
  if (t.font) r.setProperty("--font", `"${t.font}", ui-monospace, monospace`);
  r.setProperty("color-scheme", t.colors?.mode === "light" ? "light" : "dark");
  $("themeName").textContent = t.name ? `theme ${t.name}` : "";
}
function dur(s) {
  if (s == null || !isFinite(s) || s < 0) return "–";
  s = Math.floor(s);
  if (s < 60) return s + "s";
  const m = Math.floor(s / 60), h = Math.floor(m / 60), d = Math.floor(h / 24);
  return d ? `${d}d ${h % 24}h` : h ? `${h}h ${m % 60}m` : `${m}m`;
}
const size = (b) => b == null ? "–" : b >= 1073741824 ? (b / 1073741824).toFixed(1) + "G" : Math.round(b / 1048576) + "M";
const prNum = (u) => (String(u).match(/\/pull\/(\d+)/) || [])[1] || "";
const toEpoch = (a) => a == null ? null : /^\d+(\.\d+)?$/.test(String(a)) ? Number(a) : Date.parse(a) / 1000;
const ago = (a) => { const e = toEpoch(a); return e ? dur(Date.now() / 1000 - e) + " ago" : ""; };
const statusLine = (a) => !a?.line ? "" : `<div class="tstat" title="the agent's own status line">${a.line.split("│").map((x) => esc(x.trim())).join('<span class="sep">│</span>')}</div>`;
const agentChips = (a) => !a ? "" : [
  a.model ? `<span class="chip"><span class="k">model</span>${esc(a.model)}${a.effort ? ` · ${esc(a.effort)}` : ""}</span>` : "",
  a.ctx ? `<span class="chip" title="context used"><span class="k">ctx</span>${esc(a.ctx)}${a.ctx_pct ? ` · ${esc(a.ctx_pct)}` : ""}</span>` : "",
  a.cost ? `<span class="chip" title="spend this session"><span class="k">cost</span>${esc(a.cost)}</span>` : "",
].join("");
const money = (c) => Number(String(c || "").replace(/[^0-9.]/g, "")) || 0;

function renderSide() {
  const w = deck.workers || [];
  if (sel !== FM_ID && !w.some((x) => x.id === sel)) sel = w[0]?.id || FM_ID;
  $("wcount").textContent = w.length;
  const f = deck.firstmate || {};
  $("fmrow").innerHTML = `
    <button class="row b-fm${sel === FM_ID && !selBoard && !selNeed ? " sel" : ""}" id="fmbtn">
      <span class="d${f.busy ? " live" : ""}"></span>
      <span><span class="t">firstmate</span><span class="s">supervisor${f.agent?.model ? ` · ${esc(f.agent.model)}` : ""}${f.agent?.cost ? ` · ${esc(f.agent.cost)}` : ""}</span></span>
      <span class="st">${f.busy ? "busy" : "idle"}</span>
    </button>`;
  $("fmbtn").onclick = () => select(FM_ID);
  const review = liveBoards().filter((b) => b.kind === "worker" && b.status === "open");
  const needs = [
    ...deck.waiting.filter((x) => !x.board).map((x) => `<a class="need b-you${selNeed === "call:" + x.id ? " sel" : ""}" href="#" data-need="call:${esc(x.id)}"><span class="d"></span><span><span class="t">${esc(x.call?.title || "Decision: " + x.title)}</span><span class="s">${esc(x.call ? x.title : x.reason)}</span></span></a>`),
    ...review.map((b) => `<a class="need b-plan" href="#" data-board="${esc(b.key)}"><span class="d"></span><span><span class="t">Plan to review</span><span class="s">${esc(b.title)} · by ${esc(b.owner)}</span></span></a>`),
    ...deck.ready.map((x) => `<a class="need b-ready${selNeed === "merge:" + x.id ? " sel" : ""}" href="#" data-need="merge:${esc(x.id)}"><span class="d"></span><span><span class="t">PR #${esc(prNum(x.pr))} ready to merge</span><span class="s">${esc(x.title)}</span></span></a>`),
  ];
  $("needs").innerHTML = needs.length ? `<div class="grp"><span>needs you</span><span>${needs.length}</span></div>${needs.join("")}` : "";
  $("needs").querySelectorAll("[data-need]").forEach((el) => el.onclick = (e) => { e.preventDefault(); selectNeed(el.dataset.need); });
  $("list").innerHTML = w.length ? w.map((x) => `
    <button class="row b-${esc(x.badge)}${x.id === sel && !selBoard && !selNeed ? " sel" : ""}" data-id="${esc(x.id)}">
      <span class="d${x.busy ? " live" : ""}"></span>
      <span><span class="t">${esc(x.title)}</span><span class="s">${esc(x.id)} · ${dur(x.started ? deck.generated - x.started : null)}${x.agent?.model ? ` · ${esc(x.agent.model.replace(/^Claude /, ""))}` : ""}${x.agent?.cost ? ` · ${esc(x.agent.cost)}` : ""}</span></span>
      <span class="st">${esc(x.label)}</span>
    </button>`).join("") : `<div class="s" style="padding:8px 9px;color:var(--fg-dim)">no workers running</div>`;
  $("list").querySelectorAll(".row").forEach((b) => b.onclick = () => select(b.dataset.id));
  const boards = liveBoards();
  if (selBoard && !boards.some((b) => b.key === selBoard)) selBoard = null;
  $("plans").innerHTML = boards.length ? `<div class="grp"><span>plans to review</span><span>${boards.length}</span></div>
    <nav class="list">${boards.map((b) => `
    <button class="row b-plan${b.key === selBoard && !selNeed ? " sel" : ""}" data-board="${esc(b.key)}">
      <span class="ic"></span>
      <span><span class="t">${esc(b.title)}</span><span class="s">by ${esc(b.owner)} · ${ago(b.mtime)}</span></span>
      <span class="st">${b.status === "feedback" ? "queued" : ""}</span>
    </button>`).join("")}</nav>` : "";
  document.querySelectorAll("[data-board]").forEach((el) => el.onclick = (e) => { e.preventDefault(); selectBoard(el.dataset.board); });
}

function renderBoard(b) {
  const main = $("main");
  const v = `${b.rev ?? ""}-${b.mtime}`;
  const owner = b.kind === "worker" && b.owner_id ? `<span class="chip link" data-worker="${esc(b.owner_id)}" style="cursor:pointer"><span class="k">by</span>${esc(b.owner)}</span>` : `<span class="chip"><span class="k">by</span>${esc(ownerLabel(b))}</span>`;
  const head = `
      <div class="tools"><span class="ferr" id="ferr"></span><button class="btn-p" id="commentBtn">Comment in Lavish ↗</button><button class="icon-btn" data-chat>chat</button></div>
      <div class="crumbs">plans <span>/</span> <b>${esc(b.name)}</b></div>
      <h1>${esc(b.title)}</h1>
      <div class="chips">${owner}
        <span class="chip state ${b.status === "open" ? "b-plan" : "b-other"}">${esc(STATUS[b.status] || b.status || "unknown")}</span>
        <span class="chip"><span class="k">updated</span>${ago(b.mtime)}</span>
        ${b.rev != null ? `<span class="chip"><span class="k">rev</span>${esc(b.rev)}</span>` : ""}
      </div>`;
  let frame = main.querySelector(".frame iframe");
  if (!frame || frame.dataset.key !== b.key) {
    main.innerHTML = `<header class="mh b-plan" id="bhead"></header>
      <div class="body"><div class="bgrid"><div class="frame">
        <div class="tbar"><i></i><i></i><i></i><span>${esc(b.name)}</span><span class="r">answers you queue land in the feedback tray</span><button class="fv" id="fullBtn" title="Full view (f) · Esc to leave">⤢ full view</button></div>
        <iframe sandbox="allow-scripts allow-popups allow-forms allow-modals" referrerpolicy="no-referrer" data-key="${esc(b.key)}" data-v="${esc(v)}" src="/board/${esc(b.key)}/?v=${encodeURIComponent(v)}" title="${esc(b.title)}"></iframe>
        <div class="fbar"><span id="fbarText"></span><button class="btn-p" id="fbarSend">Send to agent</button></div>
      </div><aside class="review" id="review"></aside></div></div>`;
    frame = main.querySelector("iframe");
    frame.onload = () => postAnnotate();
    $("fullBtn").onclick = () => toggleFull();
    $("fbarSend").onclick = () => sendReview();
    annotating = false; reviewBoard = b; loadThread(b.key); renderReview();
  } else if (frame.dataset.v !== v) {
    frame.dataset.v = v; frame.src = `/board/${b.key}/?v=${encodeURIComponent(v)}`;
  }
  reviewBoard = b;
  const wl = $("wlatest"), w = (deck.workers || []).find((x) => x.id === b.owner_id);
  if (wl) wl.innerHTML = w?.doing ? linkify(w.doing) : '<span class="rempty">nothing on its screen yet</span>';
  const errText = $("ferr")?.textContent || "";
  $("bhead").innerHTML = head;
  if (errText) $("ferr").textContent = errText;
  main.querySelectorAll("[data-worker]").forEach((el) => el.onclick = () => select(el.dataset.worker));
  $("commentBtn").onclick = async () => {
    const win = window.open("about:blank", "_blank");
    $("commentBtn").disabled = true; $("ferr").textContent = "";
    try {
      const r = await fetch(`/api/board/${b.key}/open`, { method: "POST", headers: { "Content-Type": "application/json", "X-Crew-Deck": "1" }, body: "{}" });
      const d = await r.json().catch(() => ({}));
      if (!d.ok) throw new Error(d.error || "Lavish would not open it");
      if (win) win.location = d.url; else window.open(d.url, "_blank");
    } catch (err) { if (win) win.close(); $("ferr").textContent = String(err.message || err); }
    $("commentBtn").disabled = false;
  };
  bindChatBtn();
}

function renderFirstmate() {
  const f = deck.firstmate || {}, main = $("main");
  const preOld = main.querySelector("pre"), atBottom = !preOld || preOld.scrollHeight - preOld.scrollTop - preOld.clientHeight < 40, keep = preOld && preOld.dataset.id === FM_ID ? preOld.scrollTop : null;
  const landed = f.landed || [], act = f.activity || [];
  const short = (s) => (s || "").slice(0, 7);
  main.innerHTML = `
    <header class="mh b-fm">
      <div class="tools"><button class="icon-btn" data-chat>chat</button></div>
      <div class="crumbs">firstmate <span>/</span> <b>supervisor</b></div>
      <h1>Firstmate</h1>
      <div class="chips">
        <span class="chip state"><span class="d${f.busy ? " live" : ""}"></span>${f.busy ? "busy" : "idle"}</span>
        ${agentChips(f.agent)}
        <span class="chip"><span class="k">workers</span>${(deck.workers || []).length}</span>
        <span class="chip"><span class="k">merged</span>${landed.filter((x) => x.verb === "merged").length}</span>
        ${f.target ? `<span class="chip"><span class="k">tmux</span>${esc(f.target)}</span>` : ""}
      </div>
    </header>
    <div class="body">
      ${f.doing ? `<section class="latest b-fm"><div class="lh">${f.busy ? '<span class="d live"></span>working now' : "latest from firstmate"}</div><p>${linkify(f.doing)}</p></section>` : ""}
      <div class="tabs">
        <button class="tab${fmTab === "terminal" ? " on" : ""}" data-fmtab="terminal">terminal</button>
        <button class="tab${fmTab === "landed" ? " on" : ""}" data-fmtab="landed">landed<span class="n">${landed.length}</span></button>
        <button class="tab${fmTab === "activity" ? " on" : ""}" data-fmtab="activity">activity<span class="n">${act.length}</span></button>
      </div>
      <div class="pane">${fmTab === "terminal" ? `
        <div class="term">
          <div class="tbar"><i></i><i></i><i></i><span>${esc(f.target || "firstmate window not found")}</span><span class="r">read-only</span></div>
          <pre data-id="${FM_ID}">${esc((f.screen || []).join("\n")) || "(empty screen)"}</pre>
          ${statusLine(f.agent)}
        </div>` : fmTab === "landed" ? `
        <div class="ev">${landed.map((x) => `
          <div class="ev-row ${x.verb === "merged" ? "t-done" : "t-resolved"}" style="grid-template-columns: 96px 92px minmax(0,1fr)">
            <time>${x.at ? ago(x.at) : esc(x.date || "–")}</time>
            <span class="tag">${x.verb === "merged" ? "✓ merged" : esc(x.verb || "done")}</span>
            <span class="note"><span style="color:var(--fg-bright)">${esc(x.title)}</span><br>
              <span style="color:var(--fg-dim)">${x.pr ? `<a href="${esc(x.pr)}" target="_blank" rel="noopener">PR #${esc(prNum(x.pr))}</a>` : esc(x.kind || "")}${x.head ? ` · ${esc(x.head)} → <b style="color:var(--fg)">${esc(x.base)}</b>` : ""}${x.commit ? ` · ${esc(short(x.commit))}` : ""}${x.by ? ` · by ${esc(x.by)} via firstmate` : ""}</span></span>
          </div>`).join("") || '<div class="empty">Nothing landed yet.</div>'}</div>` : `
        <div class="ev">${act.map((a) => `
          <div class="ev-row t-${a.kind === "merged" ? "done" : a.kind === "note" ? "resolved" : esc(a.kind)}" style="grid-template-columns: 64px 150px minmax(0,1fr)">
            <time>${dur(deck.generated - a.at)}</time>
            <span class="tag">${a.who === "firstmate" ? "firstmate" : esc(a.who)}<br><span style="color:var(--fg-dim)">${esc(a.kind)}</span></span>
            <span class="note">${a.title && a.who === "firstmate" ? `<span style="color:var(--fg-dim)">${esc(a.title)}</span><br>` : ""}${linkify(a.text)}</span>
          </div>`).join("") || '<div class="empty">No activity yet.</div>'}</div>`}
      </div>
    </div>`;
  main.querySelectorAll("[data-fmtab]").forEach((b) => b.onclick = () => { fmTab = b.dataset.fmtab; store.set("crew-deck-fmtab", fmTab); renderFirstmate(); });
  const pre = main.querySelector("pre");
  if (pre) pre.scrollTop = (keep != null && !atBottom) ? keep : pre.scrollHeight;
  bindChatBtn();
}

function findNeed(k) {
  if (!k) return null;
  const [kind, id] = [k.slice(0, k.indexOf(":")), k.slice(k.indexOf(":") + 1)];
  const item = kind === "call" ? deck.waiting.find((x) => x.id === id) : kind === "merge" ? deck.ready.find((x) => x.id === id) : null;
  return item ? { kind, id, item } : null;
}

function renderNeed(n) {
  const main = $("main"), key = `${selNeed}|${JSON.stringify(n.item)}|${JSON.stringify(sentMap()[selNeed] || null)}`;
  if (key === needKey && main.querySelector(".dec")) return;
  needKey = key;
  const sent = sentMap()[selNeed];
  const it = n.item, call = it.call;
  let body = "";
  if (n.kind === "call") {
    const opts = call ? call.options : [];
    body = `
      <div class="q">${linkify(call ? call.question : it.reason)}</div>
      ${call?.context?.length ? `<ul class="ctx">${call.context.map((c) => `<li>${linkify(c)}</li>`).join("")}</ul>` : ""}
      ${opts.length ? `<div class="opts">${opts.map((o) => `
        <button class="opt${choice[selNeed] === o.id ? " on" : ""}" data-opt="${esc(o.id)}">
          <span class="rb"></span>
          <span><span class="ol">${esc(o.id)}. ${esc(o.label)}</span>${o.recommended ? '<span class="rec">recommended</span>' : ""}<div class="od">${linkify(o.detail || "")}</div></span>
        </button>`).join("")}</div>` : ""}
      <textarea id="dnote" placeholder="${opts.length ? "Optional note for firstmate…" : "Your answer for firstmate…"}">${esc(noteText[selNeed] || "")}</textarea>
      <div class="act"><button class="btn-p" id="dsend">Send decision</button><span class="ferr" id="derr"></span></div>`;
  } else {
    body = `
      <div class="q">The worker finished <b>${esc(it.title)}</b>, and its PR passed every check. It's waiting for your word to merge.</div>
      <ul class="ctx">
        <li>PR: <a href="${esc(it.pr)}" target="_blank" rel="noopener">${esc(it.pr)}</a></li>
        ${it.branch ? `<li>Branch <b>${esc(it.branch)}</b> → <b>${esc(it.base || "its base branch")}</b></li>` : ""}
      </ul>
      <textarea id="dnote" placeholder="Optional note for firstmate…">${esc(noteText[selNeed] || "")}</textarea>
      <div class="act"><button class="btn-p" data-merge="merge">Merge into ${esc(it.base || "base")}</button><button class="btn-s" data-merge="hold">Not yet</button>
        <a class="btn-s" href="${esc(it.pr)}" target="_blank" rel="noopener">Open PR ↗</a><span class="ferr" id="derr"></span></div>`;
  }
  main.innerHTML = `
    <header class="mh b-you">
      <div class="tools"><button class="icon-btn" data-chat>chat</button></div>
      <div class="crumbs">needs you <span>/</span> <b>${esc(n.id)}</b></div>
      <h1>${esc(n.kind === "call" ? (call?.title || "Decision: " + it.title) : `Merge PR #${prNum(it.pr)}?`)}</h1>
      <div class="chips"><span class="chip"><span class="k">task</span>${esc(it.title)}</span>${it.repo ? `<span class="chip"><span class="k">repo</span>${esc(it.repo)}</span>` : ""}</div>
    </header>
    <div class="body"><div class="dec">
      ${sent ? `<div class="sent">Sent ${ago(sent.at)}: “${esc(sent.text)}” Firstmate will act on it when it next checks in. This stays here until it does; you can send a different answer.</div>` : ""}
      ${body}
    </div></div>`;
  main.querySelectorAll("[data-opt]").forEach((b) => b.onclick = () => { choice[selNeed] = b.dataset.opt; main.querySelectorAll("[data-opt]").forEach((x) => x.classList.toggle("on", x === b)); });
  const note = $("dnote"); if (note) note.oninput = () => { noteText[selNeed] = note.value; };
  const send = async (payload) => {
    $("derr").textContent = "";
    try {
      const r = await fetch("/api/decide", { method: "POST", headers: { "Content-Type": "application/json", "X-Crew-Deck": "1" },
        body: JSON.stringify({ ...payload, task: n.id, note: noteText[selNeed] || "", rid: crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) }) });
      const d = await r.json().catch(() => ({}));
      if (!d.ok) throw new Error(d.error || "firstmate's inbox did not take it");
      const m = sentMap(); m[selNeed] = { at: Date.now() / 1000, text: d.text }; store.set("crew-deck-sent", JSON.stringify(m));
      noteText[selNeed] = ""; needKey = ""; renderNeed(n); chatKey = ""; chatTick();
    } catch (err) { $("derr").textContent = String(err.message || err); }
  };
  const ds = $("dsend");
  if (ds) ds.onclick = () => {
    if (call?.options?.length && !choice[selNeed] && !(noteText[selNeed] || "").trim()) { $("derr").textContent = "Pick an option or write an answer first."; return; }
    send({ kind: "call", option: choice[selNeed] || null });
  };
  main.querySelectorAll("[data-merge]").forEach((b) => b.onclick = () => send({ kind: "merge", option: b.dataset.merge }));
  bindChatBtn();
}

let annotating = false, reviewBoard = null;
const threads = {};
const qStore = (k) => { try { return JSON.parse(store.get("crew-deck-q-" + k) || "[]"); } catch { return []; } };
const qSave = (k, q) => store.set("crew-deck-q-" + k, JSON.stringify(q));
function postAnnotate() { const fr = document.querySelector(".frame iframe"); try { fr?.contentWindow?.postMessage({ crewDeck: 1, type: "annotate", on: annotating }, "*"); } catch {} }
async function loadThread(k) { try { const r = await fetch(`/api/board/${k}/thread`, { cache: "no-store" }); threads[k] = (await r.json()).thread || []; renderReview(); } catch {} }

function renderReview() {
  const box = $("review"), b = reviewBoard;
  if (!box || !b) return;
  const q = qStore(b.key), hist = threads[b.key] || [];
  const w = (deck.workers || []).find((x) => x.id === b.owner_id);
  const items = q.map((it, i) => {
    if (it.kind === "answer") return `<div class="ritem"><button class="rx" data-rm="${i}" aria-label="Remove">✕</button><div class="rk">answer${it.queueKey ? " · " + esc(it.queueKey) : ""}</div><div class="rt">${esc(it.label || it.text)}</div></div>`;
    if (it.kind === "comment") return `<div class="ritem"><button class="rx" data-rm="${i}" aria-label="Remove">✕</button><div class="rk">comment ${q.slice(0, i + 1).filter((x) => x.kind === "comment").length}${it.element?.context ? " · " + esc(it.element.context) : ""}</div><div class="quote">${esc((it.element?.text || it.element?.selector || "").slice(0, 120))}</div><div class="rt">${esc(it.text)}</div></div>`;
    return `<div class="ritem"><button class="rx" data-rm="${i}" aria-label="Remove">✕</button><div class="rk">question</div><div class="rt">${esc(it.text)}</div></div>`;
  }).join("");
  box.innerHTML = `
    <div class="rh"><b>Feedback</b><span>to ${esc(w ? w.title : b.owner)}</span></div>
    <div class="rtools"><button class="btn-s${annotating ? " on" : ""}" id="annBtn">✎ ${annotating ? "Annotating: click the plan" : "Annotate"}</button><span>${annotating ? "click a part of the plan · Esc stops" : "comment on any part of the plan"}</span></div>
    ${items || '<div class="rempty">Queue answers in the plan, annotate a part of it, or ask a question below. Nothing goes to the worker until you press Send.</div>'}
    <textarea id="askText" placeholder="Ask the worker a question or add a note…"></textarea>
    <div class="rrow"><button class="btn-s" id="askAdd">Add to feedback</button></div>
    <div class="rrow"><button class="btn-p" id="sendRev"${q.length ? "" : " disabled"}>Send to agent${q.length ? ` (${q.length})` : ""}</button><span class="ferr" id="rerr"></span></div>
    ${hist.length ? `<div class="rhist"><div class="lh">sent</div>${hist.slice().reverse().map((h) => `<div class="hi"><time>${ago(h.at)}</time> · ${h.items.length} item${h.items.length === 1 ? "" : "s"}: ${esc(h.items.map((x) => x.kind === "comment" ? "comment" : x.kind === "question" ? "question" : (x.queueKey || "answer")).join(", "))}</div>`).join("")}</div>` : ""}
    <div><div class="lh">latest from the worker</div><p id="wlatest" style="margin:0;color:var(--fg);font-size:12.5px;white-space:pre-wrap">${w?.doing ? linkify(w.doing) : '<span class="rempty">nothing on its screen yet</span>'}</p></div>`;
  const fb = $("fbarText"); if (fb) fb.textContent = q.length ? `${q.length} queued` : "nothing queued";
  box.querySelectorAll("[data-rm]").forEach((x) => x.onclick = () => {
    const qq = qStore(b.key), [gone] = qq.splice(Number(x.dataset.rm), 1); qSave(b.key, qq);
    if (gone?.markId) try { document.querySelector(".frame iframe")?.contentWindow?.postMessage({ crewDeck: 1, type: "unmark", markId: gone.markId }, "*"); } catch {}
    renderReview();
  });
  $("annBtn").onclick = () => { annotating = !annotating; postAnnotate(); renderReview(); };
  $("askAdd").onclick = () => { const t = $("askText").value.trim(); if (!t) return; const qq = qStore(b.key); qq.push({ kind: "question", text: t }); qSave(b.key, qq); renderReview(); };
  $("sendRev").onclick = () => sendReview();
}

let sendingReview = false;
async function sendReview() {
  const b = reviewBoard; if (!b || sendingReview) return;
  const q = qStore(b.key);
  const err = $("rerr");
  if (!q.length) { if (err) err.textContent = "Nothing to send yet."; return; }
  sendingReview = true;
  document.querySelectorAll("#sendRev, #fbarSend").forEach((x) => { x.disabled = true; x.textContent = "Sending…"; });
  try {
    const r = await fetch(`/api/board/${b.key}/send`, { method: "POST", headers: { "Content-Type": "application/json", "X-Crew-Deck": "1" }, body: JSON.stringify({ items: q }) });
    const d = await r.json().catch(() => ({}));
    if (!d.ok) throw new Error(d.error || "the worker did not get it");
    qSave(b.key, []); annotating = false; postAnnotate(); await loadThread(b.key); renderReview();
  } catch (e) { const er = $("rerr"); if (er) er.textContent = String(e.message || e); }
  sendingReview = false;
  const fs = $("fbarSend"); if (fs) { fs.disabled = false; fs.textContent = "Send to agent"; }
  renderReview();
}

window.addEventListener("message", (e) => {
  const fr = document.querySelector(".frame iframe");
  if (!fr || e.source !== fr.contentWindow) return;
  const d = e.data || {}; if (!d.crewDeck || !reviewBoard) return;
  const k = fr.dataset.key, q = qStore(k);
  if (d.type === "queue") {
    const item = { kind: "answer", text: String(d.text || "").slice(0, 4000), label: d.label ? String(d.label).slice(0, 400) : null, data: d.data || null, queueKey: d.queueKey || null, element: d.element || null };
    const i = item.queueKey ? q.findIndex((x) => x.kind === "answer" && x.queueKey === item.queueKey) : -1;
    if (i >= 0) q[i] = item; else q.push(item);
    qSave(k, q); renderReview();
  } else if (d.type === "send") { sendReview(); }
  else if (d.type === "comment") {
    const text = String(d.text || "").trim().slice(0, 4000);
    if (text) { q.push({ kind: "comment", element: d.element || null, text, markId: d.markId || null }); qSave(k, q); renderReview(); }
  } else if (d.type === "stop-annotate") { annotating = false; renderReview(); }
});

function toggleFull(force) {
  const fr = document.querySelector(".frame");
  if (!fr) return;
  const on = force ?? !fr.classList.contains("full");
  fr.classList.toggle("full", on);
  const b = $("fullBtn"); if (b) b.textContent = on ? "⤡ exit full view" : "⤢ full view";
}

function renderMain() {
  const boardMode = !selNeed && !!selBoard && (deck.boards || []).some((b) => b.key === selBoard);
  document.querySelector(".app").classList.toggle("board-mode", boardMode);
  const need = findNeed(selNeed);
  if (selNeed && !need) { selNeed = null; store.set("crew-deck-need", ""); }
  if (need) return renderNeed(need);
  needKey = "";
  const board = selBoard && (deck.boards || []).find((b) => b.key === selBoard);
  if (board) return renderBoard(board);
  if (sel === FM_ID) return renderFirstmate();
  const x = (deck.workers || []).find((w) => w.id === sel);
  const main = $("main");
  if (!deck.ok) { main.innerHTML = `<div class="empty"><b>Can't read the fleet</b>Firstmate's records at ${esc(deck.home)} didn't load.</div>`; return; }
  if (!x) { main.innerHTML = `<div class="mh"><div class="tools"><button class="icon-btn" data-chat>chat</button></div><div class="crumbs">firstmate</div><h1>No workers running</h1></div><div class="empty"><b>All quiet</b>New workers show up here as soon as firstmate starts them.</div>`; bindChatBtn(); return; }
  const preOld = main.querySelector("pre"), atBottom = !preOld || preOld.scrollHeight - preOld.scrollTop - preOld.clientHeight < 40, keep = preOld && preOld.dataset.id === x.id ? preOld.scrollTop : null;
  main.innerHTML = `
    <header class="mh b-${esc(x.badge)}">
      <div class="tools"><button class="icon-btn" data-chat>chat</button></div>
      <div class="crumbs">${esc(x.repo || "project")} <span>/</span> <b>${esc(x.id)}</b></div>
      <h1>${esc(x.title)}</h1>
      <div class="chips">
        <span class="chip state"><span class="d${x.busy ? " live" : ""}"></span>${esc(x.label)}</span>
        ${agentChips(x.agent)}
        ${x.branch ? `<span class="chip"><span class="k">⎇</span>${esc(x.branch)}</span>` : ""}
        <span class="chip"><span class="k">up</span>${dur(x.started ? deck.generated - x.started : null)}</span>
        ${x.rss ? `<span class="chip"><span class="k">mem</span>${size(x.rss)}</span>` : ""}
        ${x.pr ? `<a class="chip link" href="${esc(x.pr)}" target="_blank" rel="noopener"><span class="k">PR</span>#${esc(prNum(x.pr))} ↗</a>` : ""}
        ${liveBoards().filter((b) => b.owner_id === x.id).map((b) => `<span class="chip plan" data-board="${esc(b.key)}"><span class="k">plan</span>${esc(b.title)}</span>`).join("")}
      </div>
    </header>
    <div class="body">
      <section class="latest b-${esc(x.badge)}">
        <div class="lh">${x.busy ? '<span class="d live"></span>working now' : "latest from the worker"}</div>
        ${x.doing ? `<p>${linkify(x.doing)}</p>` : '<p class="none">Nothing on its screen yet.</p>'}
      </section>
      <div class="tabs">
        <button class="tab${tab === "terminal" ? " on" : ""}" data-tab="terminal">terminal</button>
        <button class="tab${tab === "events" ? " on" : ""}" data-tab="events">events<span class="n">${(x.events || []).length}</span></button>
      </div>
      <div class="pane">${tab === "terminal" ? `
        <div class="term">
          <div class="tbar"><i></i><i></i><i></i><span>${esc(x.target || "")}</span><span class="r">read-only</span></div>
          <pre data-id="${esc(x.id)}">${esc((x.screen || []).join("\n")) || "(empty screen)"}</pre>
          ${statusLine(x.agent)}
        </div>` : `
        <div class="ev">${(x.events || []).map((e) => `<div class="ev-row t-${esc(e.state)}"><time>${e.at ? dur(deck.generated - e.at) : "–"}</time><span class="tag">${esc(e.state)}</span><span class="note">${linkify(e.note)}</span></div>`).join("") || '<div class="empty">No events yet.</div>'}</div>`}
      </div>
    </div>`;
  main.querySelectorAll(".tab").forEach((b) => b.onclick = () => { tab = b.dataset.tab; store.set("crew-deck-tab", tab); renderMain(); });
  const pre = main.querySelector("pre");
  if (pre) pre.scrollTop = (keep != null && !atBottom) ? keep : pre.scrollHeight;
  main.querySelectorAll("[data-board]").forEach((el) => el.onclick = () => selectBoard(el.dataset.board));
  bindChatBtn();
}

function renderStatus() {
  const agents = [deck.firstmate?.agent, ...(deck.workers || []).map((w) => w.agent)].filter(Boolean);
  const a = agents.find((x) => x.five_hour) || {};
  const pct = (v) => Number(String(v || "").replace("%", "")) || 0;
  const hot = (v) => pct(v) >= 90 ? "var(--red)" : pct(v) >= 75 ? "var(--yellow)" : "var(--fg)";
  const total = agents.reduce((t, x) => t + money(x.cost), 0);
  $("plan").innerHTML = (a.five_hour ? `plan 5h <b style="color:${hot(a.five_hour)}">${esc(a.five_hour)}</b>${a.five_hour_reset ? ` ↻${esc(a.five_hour_reset)}` : ""}${a.week ? ` · wk <b style="color:${hot(a.week)}">${esc(a.week)}</b>` : ""}` : "")
    + (total ? ` · spend <b>$${total.toFixed(2)}</b>` : "");
  const m = deck.memory || {};
  const frac = m.total ? m.used / m.total : 0, n = 14, f = Math.round(frac * n);
  const color = frac > 0.85 ? "var(--red)" : frac > 0.7 ? "var(--yellow)" : "var(--fg)";
  $("mem").innerHTML = m.total ? `mem <b style="color:${color}">${size(m.used)}</b>/${size(m.total)} <span style="color:${color}">${"▮".repeat(f)}</span><span style="opacity:.35">${"▮".repeat(n - f)}</span>${m.swap_used > 104857600 ? ` · swap <b>${size(m.swap_used)}</b>` : ""}` : "";
}

function select(id) { sel = id; selBoard = null; selNeed = null; store.set("crew-deck-sel", id); store.set("crew-deck-board", ""); store.set("crew-deck-need", ""); renderSide(); renderMain(); }
function selectBoard(key) { selBoard = key; selNeed = null; store.set("crew-deck-board", key); store.set("crew-deck-need", ""); renderSide(); renderMain(); }
function selectNeed(k) { selNeed = k; needKey = ""; store.set("crew-deck-need", k); renderSide(); renderMain(); }
function bindChatBtn() { document.querySelectorAll("[data-chat]").forEach((b) => b.onclick = () => openChat()); }
function openChat() { $("chat").classList.add("open"); $("input").focus(); }

async function tick() {
  try {
    const r = await fetch("/api/deck", { cache: "no-store" });
    if (!r.ok) throw new Error(r.status);
    deck = await r.json(); lastOk = Date.now();
    applyTheme(deck.theme); renderSide(); renderMain(); renderStatus();
  } catch { $("live").innerHTML = '<span class="offline">● disconnected — retrying</span>'; }
}

const SHOT = /\n?\n?\[Attached [^\]]*from the crew deck[^\]]*\]\n?([\s\S]*)$/;
function msgHtml(m) {
  const k = SHOT.exec(m.body || "");
  const text = k ? m.body.slice(0, k.index) : (m.body || "");
  const names = k ? (k[1].match(/[0-9]{8}-[0-9]{6}-[0-9a-f]{8}\.(?:png|jpg|webp|gif)/g) || []) : [];
  const srcs = [...names.map((n) => "/upload/" + n), ...(m.previews || [])];
  return (text ? linkify(text) : "") + (srcs.length ? `<div class="shots">${srcs.map((u) => `<a href="${esc(u)}" target="_blank" rel="noopener"><img src="${esc(u)}" alt="attached image"></a>`).join("")}</div>` : "");
}
const sameMsg = (m, p) => (p.rid && m.rid === p.rid) || m.body === p.body;
function renderChat(msgs) {
  const all = [...msgs];
  for (const p of pending) if (!msgs.some((m) => sameMsg(m, p))) all.push(p);
  pending = pending.filter((p) => !msgs.some((m) => sameMsg(m, p)));
  const key = JSON.stringify(all);
  if (key === chatKey) return;
  chatKey = key;
  const box = $("msgs"), atBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 60;
  if (!all.length) { box.innerHTML = `<div class="intro"><b>Talk to firstmate</b>Ask about the fleet or hand it a task. Messages go to firstmate's inbox and wake it; the answer appears here.</div>`; return; }
  const waiting = all.some((m) => m.state !== "answered");
  box.innerHTML = all.map((m) => `
    <div class="m me"><div class="bub">${msgHtml(m)}</div>
      <div class="meta">${ago(m.at)} · ${m.state === "answered" ? '<span class="ok">answered</span>' : m.state === "seen" ? '<span class="ok">seen</span>' : m.state === "sending" ? "sending…" : '<span class="wait">delivered</span>'}</div></div>
    ${m.reply ? `<div class="m fm"><div class="bub">${linkify(m.reply.body)}</div><div class="meta">firstmate · ${ago(m.reply.at)}</div></div>` : ""}`).join("")
    + (waiting ? `<div class="typing"><i></i><i></i><i></i> firstmate will answer when it next checks in</div>` : "");
  if (atBottom) box.scrollTop = box.scrollHeight;
}

async function chatTick() {
  try {
    const r = await fetch("/api/chat", { cache: "no-store" });
    const d = await r.json();
    renderChat(d.messages || []);
  } catch {}
}

let atts = [];
const IMG_TYPES = ["image/png", "image/jpeg", "image/webp", "image/gif"];
function chatErr(msg) { $("err").textContent = msg; $("err").classList.toggle("show", !!msg); }
function renderAtts() {
  $("atts").innerHTML = atts.map((a, i) => `<div class="att"><img src="${a.url}" alt="image to send"><button type="button" data-rm="${i}" aria-label="Remove image">✕</button></div>`).join("");
  $("atts").querySelectorAll("[data-rm]").forEach((b) => b.onclick = () => { const [a] = atts.splice(+b.dataset.rm, 1); URL.revokeObjectURL(a.url); renderAtts(); });
}
function addImages(files) {
  let added = 0;
  for (const f of files) {
    if (!IMG_TYPES.includes(f.type)) { chatErr("Only PNG, JPEG, WebP and GIF images can be attached."); continue; }
    if (f.size > 10 * 1024 * 1024) { chatErr("Each image must be under 10 MB."); continue; }
    if (atts.length >= 6) { chatErr("At most 6 images per message."); break; }
    atts.push({ file: f, type: f.type, url: URL.createObjectURL(f) }); added++;
  }
  if (added) { chatErr(""); renderAtts(); }
  return added;
}
const b64 = (f) => new Promise((ok, bad) => { const r = new FileReader(); r.onload = () => ok(String(r.result).split(",", 2)[1] || ""); r.onerror = () => bad(r.error); r.readAsDataURL(f); });
$("input").addEventListener("paste", (e) => {
  const files = [...(e.clipboardData?.items || [])].filter((i) => i.kind === "file").map((i) => i.getAsFile()).filter(Boolean);
  if (files.length && addImages(files) && !e.clipboardData.getData("text/plain")) e.preventDefault();
});
$("attach").onclick = () => $("files").click();
$("files").onchange = () => { addImages([...$("files").files]); $("files").value = ""; $("input").focus(); };
const comp = $("composer");
comp.addEventListener("dragover", (e) => { if ([...(e.dataTransfer?.types || [])].includes("Files")) { e.preventDefault(); comp.classList.add("drop"); } });
comp.addEventListener("dragleave", (e) => { if (!comp.contains(e.relatedTarget)) comp.classList.remove("drop"); });
comp.addEventListener("drop", (e) => { comp.classList.remove("drop"); if (e.dataTransfer?.files?.length) { e.preventDefault(); addImages([...e.dataTransfer.files]); $("input").focus(); } });
let chatSending = false;
$("composer").onsubmit = async (e) => {
  e.preventDefault();
  if (chatSending) return;
  const text = $("input").value.trim(), sendAtts = [...atts];
  if (!text && !sendAtts.length) return;
  chatSending = true; $("send").disabled = true; chatErr("");
  const rid = crypto.randomUUID ? crypto.randomUUID() : String(Date.now());
  const p = { body: text, rid: "crew-deck-" + rid, previews: sendAtts.map((a) => a.url), at: Date.now() / 1000, state: "sending" };
  pending.push(p);
  chatKey = ""; await chatTick(); $("msgs").scrollTop = $("msgs").scrollHeight;
  try {
    const images = await Promise.all(sendAtts.map(async (a) => ({ type: a.type, data: await b64(a.file) })));
    const r = await fetch("/api/chat", { method: "POST", headers: { "Content-Type": "application/json", "X-Crew-Deck": "1" },
      body: JSON.stringify({ text, images, rid }) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok || !d.ok) throw new Error(d.error || "firstmate's inbox did not take the message");
    $("input").value = ""; atts = atts.filter((a) => !sendAtts.includes(a)); renderAtts();
  } catch (err) {
    pending = pending.filter((x) => x !== p);
    chatErr(String(err.message || err));
  }
  chatSending = false; $("send").disabled = false; chatKey = ""; chatTick();
};
$("input").addEventListener("keydown", (e) => { if (e.key === "Enter" && !e.shiftKey && !e.isComposing) { e.preventDefault(); $("composer").requestSubmit(); } });
$("closeChat").onclick = () => $("chat").classList.remove("open");
document.addEventListener("keydown", (e) => {
  if (e.target.closest("textarea, input")) { if (e.key === "Escape") e.target.blur(); return; }
  if (e.metaKey || e.ctrlKey || e.altKey || !deck) return;
  const w = [{ id: FM_ID }, ...(deck.workers || [])], i = w.findIndex((x) => x.id === sel);
  if (e.key === "j" || e.key === "ArrowDown") { select(w[Math.min(w.length - 1, i + 1)].id); e.preventDefault(); }
  else if (e.key === "k" || e.key === "ArrowUp") { select(w[Math.max(0, i - 1)].id); e.preventDefault(); }
  else if (e.key === "t" || e.key === "e") {
    if (sel === FM_ID) { fmTab = e.key === "t" ? "terminal" : "activity"; store.set("crew-deck-fmtab", fmTab); }
    else { tab = e.key === "t" ? "terminal" : "events"; store.set("crew-deck-tab", tab); }
    renderMain();
  }
  else if (e.key === "l" && sel === FM_ID) { fmTab = "landed"; store.set("crew-deck-fmtab", fmTab); renderMain(); }
  else if (e.key === "/") { e.preventDefault(); openChat(); }
  else if (e.key === "f" && document.querySelector(".frame")) toggleFull();
  else if (e.key === "Escape") { if (annotating) { annotating = false; postAnnotate(); renderReview(); } else if (document.querySelector(".frame.full")) toggleFull(false); else $("chat").classList.remove("open"); }
});
setInterval(() => { if (lastOk) $("live").innerHTML = `<span style="color:var(--green)">●</span> live · ${dur((Date.now() - lastOk) / 1000)} ago`; }, 1000);
tick(); chatTick(); setInterval(tick, 4000); setInterval(chatTick, 4000);
</script>
</body>
