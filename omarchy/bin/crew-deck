::selection { background: var(--selection); }
::-webkit-scrollbar { width: 9px; height: 9px; }
::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--fg) 14%, transparent); border-radius: 6px; border: 2px solid transparent; background-clip: padding-box; }
