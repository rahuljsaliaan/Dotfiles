<script>
const $ = (id) => document.getElementById(id);
const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
const open = new Set();
let last = 0, themeKey = "";
const VARS = { background: "--bg", dark_background: "--bg-dark", darker_background: "--bg-darker", lighter_background: "--bg-light",
  foreground: "--fg", dark_foreground: "--fg-dim", bright_foreground: "--fg-bright", muted: "--muted", accent: "--accent",
  selection: "--selection", red: "--red", yellow: "--yellow", orange: "--orange", green: "--green", cyan: "--cyan", blue: "--blue", magenta: "--magenta" };

function applyTheme(t) {
  const key = JSON.stringify(t);
  if (!t || key === themeKey) return;
  themeKey = key;
  const root = document.documentElement.style;
  for (const [k, v] of Object.entries(VARS)) if (t.colors?.[k]) root.setProperty(v, t.colors[k]);
  if (t.font) root.setProperty("--font", `"${t.font}", ui-monospace, monospace`);
  root.setProperty("color-scheme", t.colors?.mode === "light" ? "light" : "dark");
}
function dur(s) {
  if (s == null || s < 0) return "–";
  s = Math.floor(s);
  if (s < 60) return s + "s";
  const m = Math.floor(s / 60), h = Math.floor(m / 60), d = Math.floor(h / 24);
  if (d) return `${d}d ${h % 24}h`;
  if (h) return `${h}h ${m % 60}m`;
  return `${m}m`;
}
const gb = (b) => b == null ? "–" : (b / 1073741824).toFixed(b >= 10737418240 ? 0 : 1) + " GB";
const prNum = (u) => (u.match(/\/pull\/(\d+)/) || [])[1];

function render(d) {
  applyTheme(d.theme);
  const now = d.generated, w = d.workers || [];
  $("sub").textContent = `Firstmate's workers, live${d.theme?.name ? " · " + d.theme.name + " theme" : ""}`;
  const m = d.memory || {}, frac = m.total ? m.used / m.total : 0;
  const cls = frac > 0.85 ? "hot" : frac > 0.7 ? "warn" : "";
  const swap = m.swap_used > 104857600 ? ` · swap ${gb(m.swap_used)}` : "";
  $("stats").innerHTML = `
    <div class="tile"><div class="k">Workers</div><div class="v">${w.length}</div></div>
    <div class="tile you"><div class="k">Waiting on you</div><div class="v">${d.waiting.length + d.ready.length}</div></div>
    <div class="tile ready"><div class="k">PRs ready</div><div class="v">${d.ready.length}</div></div>
    <div class="tile"><div class="k">Memory</div><div class="v">${gb(m.used)} <small>of ${gb(m.total)}${swap}</small></div>
      <div class="bar ${cls}"><i style="width:${(frac * 100).toFixed(1)}%"></i></div></div>`;
  const needs = [
    ...d.waiting.map((x) => `<div class="need"><div class="what"><div class="t">${esc(x.title)}</div><div class="r">${esc(x.reason)}</div></div></div>`),
    ...d.ready.map((x) => `<div class="need pr"><div class="what"><div class="t">${esc(x.title)}</div><div class="r">PR ready for your merge word</div></div><a class="btn" href="${esc(x.pr)}" target="_blank" rel="noopener">Open PR #${esc(prNum(x.pr))}</a></div>`),
  ];
  $("needs").innerHTML = needs.length ? `<h2>Needs you</h2>${needs.join("")}` : "";
  if (!d.ok) { $("workers").innerHTML = `<div class="empty-deck">Couldn't read Firstmate's fleet records at ${esc(d.home)}.</div>`; return; }
  if (!w.length) { $("workers").innerHTML = `<div class="empty-deck">No workers running.</div>`; return; }
  $("workers").innerHTML = `<div class="grid">${w.map((x) => `
    <article class="card b-${esc(x.badge)}">
      <div class="top">
        <div><div class="name">${esc(x.title)}</div><div class="chip">${esc(x.repo)}${x.branch ? " · " + esc(x.branch) : ""}</div></div>
        <span class="pill">${esc(x.label)}</span>
      </div>
      <div class="now"><div class="lbl">${x.busy ? '<span class="pulse"></span>Working right now' : "Latest"}</div>
        ${x.doing ? esc(x.doing) : '<span class="empty">No update on screen yet</span>'}</div>
      <div class="meta">
        <span>running <b>${dur(x.started ? now - x.started : null)}</b></span>
        ${x.rss ? `<span>memory <b>${gb(x.rss)}</b></span>` : ""}
        ${x.last_age != null ? `<span>last report <b>${dur(x.last_age)} ago</b></span>` : ""}
        ${x.pr ? `<a href="${esc(x.pr)}" target="_blank" rel="noopener">PR #${esc(prNum(x.pr))}</a>` : ""}
      </div>
      ${x.screen?.length ? `<details data-id="${esc(x.id)}"${open.has(x.id) ? " open" : ""}><summary>Screen</summary><pre>${esc(x.screen.join("\n"))}</pre></details>` : ""}
    </article>`).join("")}</div>`;
  document.querySelectorAll("details[data-id]").forEach((el) => {
    const pre = el.querySelector("pre"); if (pre) pre.scrollTop = pre.scrollHeight;
    el.addEventListener("toggle", () => el.open ? open.add(el.dataset.id) : open.delete(el.dataset.id));
  });
}

async function tick() {
  try {
    const r = await fetch("/api/deck", { cache: "no-store" });
    if (!r.ok) throw new Error(r.status);
    const d = await r.json();
    render(d); last = Date.now();
    $("banner").classList.remove("show"); $("dot").classList.remove("off");
  } catch (e) {
    $("banner").classList.add("show"); $("dot").classList.add("off");
  }
}
setInterval(() => { if (last) $("updated").textContent = `live · updated ${dur((Date.now() - last) / 1000)} ago`; }, 1000);
tick(); setInterval(tick, 4000);
</script>
</body>
</html>
"""

if __name__ == "__main__":
    main()
