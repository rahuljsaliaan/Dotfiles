#!/usr/bin/env python3
"""crew-deck - a live, read-only console for Firstmate's workers, with a chat to firstmate.

Usage:
  crew-deck           start the local server if it is not running, then open the page
  crew-deck serve     run the server in the foreground
  crew-deck stop      stop the background server
  crew-deck --json    print one snapshot and exit

It reads Firstmate's own fleet snapshot (bin/fm-fleet-view.sh --json), each
worker's status log and tmux screen, and the memory its processes use. It
never steers, stops or merges a worker. The chat panel writes to Firstmate's
captain inbox (bin/fm-inbox.sh note), which wakes firstmate, and shows the
answers firstmate publishes there (bin/fm-inbox.sh reply), so replies arrive
when firstmate next checks in rather than instantly.

Colours and font follow the current Omarchy theme (colors.toml) on every
refresh. The server listens on 127.0.0.1 only, answers only requests whose
Host is itself, and takes chat messages only with its own request header, so
another web page cannot read the console or post to firstmate's inbox.

Environment: FM_HOME (default ~/Repository/firstmate), CREW_DECK_PORT (default 4399).
"""
import base64
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time
import tomllib
import mimetypes
import urllib.parse
import urllib.request
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

HOME = Path.home()
FM = Path(os.environ.get("FM_HOME", HOME / "Repository/firstmate"))
PORT = int(os.environ.get("CREW_DECK_PORT", "4399"))
URL = f"http://127.0.0.1:{PORT}/"
HOSTS = {f"127.0.0.1:{PORT}", f"localhost:{PORT}"}
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state"))
COLORS = STATE / "omarchy/current/theme/colors.toml"
RUN = STATE / "crew-deck"
PIDFILE = RUN / "server.pid"
CACHE_SECONDS = 2.5
MAX_MESSAGE = 4000
UPLOADS = RUN / "uploads"
MAX_IMAGES = 6
MAX_IMAGE_BYTES = 10 * 1024 * 1024
IMAGE_TYPES = {"image/png": ".png", "image/jpeg": ".jpg", "image/webp": ".webp", "image/gif": ".gif"}
UPLOAD_NAME = re.compile(r"[0-9]{8}-[0-9]{6}-[0-9a-f]{8}\.(png|jpg|webp|gif)")

TOOL_LINE = re.compile(
    r"^(Bash|Read|Write|Update|Edit|MultiEdit|Search|Grep|Glob|Task|Agent|Fetch|Web\w*|List|Skill|"
    r"Reading|Writing|Searching|Running|Ran|Listing|Updating|Editing|Wrote|Called|Calling)\b"
)
CHROME = re.compile(r"^[\s─━│╭╮╰╯▐▛▜▌▝▘█▀▙▟]*$|^\s*(⏵⏵|󰚩|❯\s*$)|esc to interrupt|shift\+tab to cycle|Update available")
EVENT = re.compile(r"^([a-z][a-z-]*)\s*((?:\[[^\]]*\]\s*)*):\s?(.*)$")


def sh(args, timeout=15, env=None, stdin=None):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout, env=env, input=stdin)
        return r.returncode, r.stdout
    except (OSError, subprocess.SubprocessError):
        return 1, ""


def out(args, **kw):
    code, text = sh(args, **kw)
    return text if code == 0 else ""


FM_ENV = {**os.environ, "FM_HOME": str(FM)}


# ---------------------------------------------------------------- theme
_font = None


def theme():
    global _font
    try:
        with open(COLORS, "rb") as f:
            colors = {k: v for k, v in tomllib.load(f).items() if isinstance(v, str)}
    except (OSError, tomllib.TOMLDecodeError):
        colors = {}
    if _font is None:
        _font = out(["omarchy-font-current"], timeout=3).strip() or "monospace"
    try:
        name = (STATE / "omarchy/current/theme.name").read_text().strip()
    except OSError:
        name = out(["omarchy-theme-current"], timeout=3).strip()
    return {"colors": colors, "font": _font, "name": name}


# ---------------------------------------------------------------- memory
def meminfo():
    vals = {}
    try:
        for line in open("/proc/meminfo"):
            k, v = line.split(":", 1)
            vals[k] = int(v.split()[0]) * 1024
    except OSError:
        return None
    return {
        "total": vals.get("MemTotal", 0),
        "used": vals.get("MemTotal", 0) - vals.get("MemAvailable", 0),
        "swap_total": vals.get("SwapTotal", 0),
        "swap_used": vals.get("SwapTotal", 0) - vals.get("SwapFree", 0),
    }


def process_table():
    page = os.sysconf("SC_PAGE_SIZE")
    table = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            stat = open(f"/proc/{d}/stat").read()
            rest = stat[stat.rindex(")") + 2:].split()
            table[int(d)] = (int(rest[1]), int(rest[21]) * page)
        except (OSError, ValueError, IndexError):
            pass
    return table


def tree_rss(root, table):
    children = {}
    for pid, (ppid, _) in table.items():
        children.setdefault(ppid, []).append(pid)
    total, stack = 0, [root]
    while stack:
        pid = stack.pop()
        total += table.get(pid, (0, 0))[1]
        stack.extend(children.get(pid, []))
    return total


# ---------------------------------------------------------------- workers
def screen(target):
    raw = out(["tmux", "capture-pane", "-p", "-J", "-t", target, "-S", "-200"], timeout=5)
    lines = [l.rstrip() for l in raw.splitlines()]
    busy = any("esc to interrupt" in l for l in lines[-8:])
    kept = [l for l in lines if l.strip() and not CHROME.search(l)]
    return kept, busy, agent_status(lines)


EFFORTS = {"low", "medium", "high", "xhigh", "max"}
GLYPHS = re.compile(r"[\ue000-\uf8ff\U000f0000-\U000fffff]")


def agent_status(lines):
    """The agent's own status line (model, context, cost, plan usage), read
    from the bottom of its screen: '󰚩 Opus 5.5 high │ … │ ctx 65k 6% │ $0.33 │ 5h 51% ↻1h42m │ wk 55%'."""
    line = next((l for l in reversed(lines[-12:]) if "│" in l and re.search(r"\bctx \S+", l)), None)
    if not line:
        return None
    st = {"line": line.strip()}
    for seg in (GLYPHS.sub("", x).strip() for x in line.split("│")):
        if not seg:
            continue
        if seg.startswith("ctx "):
            parts = seg.split()
            st["ctx"] = parts[1] if len(parts) > 1 else None
            st["ctx_pct"] = parts[2] if len(parts) > 2 else None
        elif seg.startswith("$"):
            st["cost"] = seg.split()[0]
        elif seg.startswith("5h "):
            m = re.match(r"5h (\S+)(?:\s+↻\s*(\S+))?", seg)
            if m:
                st["five_hour"], st["five_hour_reset"] = m.group(1), m.group(2)
        elif seg.startswith("wk "):
            st["week"] = seg.split()[1] if len(seg.split()) > 1 else None
        elif "model" not in st and re.search(r"[A-Za-z]", seg) and "/" not in seg:
            words = seg.split()
            if words and words[-1].lower() in EFFORTS:
                st["effort"] = words.pop()
            st["model"] = " ".join(words)
    return st or None


def doing_now(lines):
    """The worker's latest plain-language paragraph: the last '●' block that is
    prose rather than a tool call."""
    blocks, cur = [], None
    for l in lines:
        if l.startswith("● "):
            cur = [l[2:].strip()]
            blocks.append(cur)
        elif cur is not None and l.startswith("  ") and not l.lstrip().startswith("⎿"):
            if re.match(r"^\s*[✻✽✶✳✢·*]\s", l):
                cur = None
            else:
                cur.append(l.strip())
        else:
            cur = None
    for b in reversed(blocks):
        text = re.sub(r"\s+", " ", " ".join(b)).strip()
        if not TOOL_LINE.match(text):
            return text[:900] + ("…" if len(text) > 900 else "")
    return ""


def events(path, limit=12):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 24000))
            tail = f.read().decode("utf-8", "replace").splitlines()[-limit:]
    except (OSError, TypeError):
        return []
    rows = []
    for line in tail:
        m = EVENT.match(line.strip())
        if not m:
            continue
        at = re.search(r"\[at=(\d+)\]", m.group(2))
        rows.append({"state": m.group(1), "at": int(at.group(1)) if at else None, "note": m.group(3)[:400]})
    return rows[::-1]


def pane_pid(target):
    o = out(["tmux", "display-message", "-p", "-t", target, "#{pane_pid}"], timeout=3).strip()
    return int(o) if o.isdigit() else None


def badge(t, held, last):
    cs = t.get("current_state") or {}
    state = cs.get("state") or "unknown"
    detail = (cs.get("detail") or "").lower()
    pr = (t.get("pr") or {}).get("url")
    last_state = (last or {}).get("state")
    last_note = ((last or {}).get("note") or "").lower()
    if held:
        return "you", "needs you"
    if (t.get("endpoint") or {}).get("exists") is False:
        return "bad", "stopped"
    if state in ("failed", "blocked"):
        return "bad", state
    if state == "parked":
        return "decide", "deciding"
    # A recorded PR is one firstmate registered as ready (bin/fm-pr-check.sh), even while a
    # pipeline's CI monitor still waits on a repo that has no CI.
    if state == "done" or pr:
        return "ready", "PR ready"
    if "fix" in detail or (last_state == "paused" and "fix" in last_note):
        return "fix", "fixing"
    if "validating" in detail or "ci" in detail.split():
        return "check", "reviewing"
    if state == "paused":
        return "wait", "waiting"
    if state == "working":
        return "work", "working"
    return "muted", "unknown"


def captain_call(task_id):
    """Firstmate's structured write-up of a decision it holds for the owner
    (data/<task>/captain-call.json): question, context and options."""
    if not task_id or "/" in task_id:
        return None
    try:
        call = json.loads((FM / "data" / task_id / "captain-call.json").read_text())
        return call if isinstance(call, dict) and call.get("options") else None
    except (OSError, ValueError):
        return None


def meta_field(task_id, key):
    try:
        for line in (FM / "state" / f"{task_id}.meta").read_text().splitlines():
            if line.startswith(key + "="):
                return line.split("=", 1)[1]
    except OSError:
        pass
    return None


def title_of(t, record):
    title = (record or {}).get("title") or t.get("id")
    repo = (record or {}).get("repo") or ""
    if repo and title.lower().startswith(repo.lower() + ":"):
        title = title[len(repo) + 1:].strip()
    return title[:1].upper() + title[1:], repo


def build():
    snap = out([str(FM / "bin/fm-fleet-view.sh"), "--json"], timeout=30, env=FM_ENV)
    try:
        snap = json.loads(snap)
    except ValueError:
        snap = None
    deck = {"generated": time.time(), "theme": theme(), "memory": meminfo(), "ok": snap is not None,
            "home": str(FM), "workers": [], "waiting": [], "ready": []}
    if not snap:
        return deck
    records = {r.get("id"): r for r in (snap.get("backlog") or {}).get("records", [])}
    table = process_table()
    for r in records.values():
        if r.get("hold_kind") == "captain" and r.get("state") != "done":
            title, repo = title_of({"id": r.get("id")}, r)
            deck["waiting"].append({"id": r.get("id"), "title": title, "repo": repo, "reason": r.get("hold_reason") or "",
                                    "call": captain_call(r.get("id"))})
    for t in snap.get("tasks", []):
        if t.get("kind") == "secondmate":
            continue
        rec = records.get(t.get("id")) or t.get("backlog") or {}
        status = (t.get("paths") or {}).get("status_log") or {}
        last = status.get("last_event")
        kind, label = badge(t, rec.get("hold_kind") == "captain", last)
        title, repo = title_of(t, rec)
        ep = t.get("endpoint") or {}
        target = ep.get("target")
        lines, busy, rss, agent = [], False, None, None
        if t.get("backend") == "tmux" and target and ep.get("exists"):
            lines, busy, agent = screen(target)
            pid = pane_pid(target)
            rss = tree_rss(pid, table) if pid else None
        m = re.match(r"s(\d+)\.", t.get("spawn_gen") or "")
        pr = (t.get("pr") or {}).get("url")
        cs = t.get("current_state") or {}
        w = {"id": t.get("id"), "title": title, "repo": repo, "badge": kind, "label": label,
             "state": cs.get("state"), "detail": cs.get("detail"),
             "doing": doing_now(lines), "busy": busy, "started": int(m.group(1)) if m else None,
             "rss": rss, "pr": pr, "branch": t.get("branch"), "target": target,
             "mode": t.get("mode"), "harness": t.get("harness"), "agent": agent,
             "worktree": ((t.get("paths") or {}).get("worktree") or {}).get("path"),
             "screen": lines[-120:], "events": events(status.get("path"))}
        deck["workers"].append(w)
        if kind == "ready" and pr:
            deck["ready"].append({"id": w["id"], "title": title, "repo": repo, "pr": pr,
                                  "base": meta_field(w["id"], "base_branch"), "branch": w.get("branch")})
    order = {"you": 0, "bad": 1, "ready": 2, "decide": 3, "fix": 4, "check": 5, "work": 6, "wait": 7, "muted": 8}
    deck["workers"].sort(key=lambda w: (order.get(w["badge"], 9), -(w["started"] or 0)))
    deck["boards"] = boards(deck["workers"])
    for item in deck["waiting"]:
        item["board"] = next((b["key"] for b in deck["boards"] if b["owner_id"] == item["id"]), None)
    for w in deck["workers"]:
        w.pop("worktree", None)
    deck["firstmate"] = firstmate_view(records, deck["workers"])
    return deck


_cache = {"at": 0.0, "deck": None}
_lock = threading.Lock()


def cached_deck():
    with _lock:
        if _cache["deck"] is None or time.time() - _cache["at"] > CACHE_SECONDS:
            _cache["deck"] = build()
            _cache["at"] = time.time()
        return _cache["deck"]


# ---------------------------------------------------------------- firstmate itself
def fm_window():
    want = os.environ.get("CREW_DECK_FM_WINDOW")
    if want:
        return want
    for line in out(["tmux", "list-windows", "-a", "-F", "#{session_name}:#{window_index}\t#{window_name}"], timeout=3).splitlines():
        target, _, name = line.partition("\t")
        if name == "firstmate":
            return target
    return None


_merges = {}


def merge_info(url):
    """GitHub's record of a merged PR, cached for good once merged; a failed
    lookup is retried at most every two minutes."""
    hit = _merges.get(url)
    if hit and (hit.get("mergedAt") or time.time() - hit.get("_tried", 0) < 120):
        return hit if hit.get("mergedAt") else None
    code, o = sh(["gh", "pr", "view", url, "--json", "number,mergedAt,mergedBy,baseRefName,headRefName,mergeCommit"], timeout=15)
    try:
        d = json.loads(o) if code == 0 else {}
    except ValueError:
        d = {}
    d["_tried"] = time.time()
    _merges[url] = d
    return d if d.get("mergedAt") else None


def iso_epoch(s):
    try:
        return time.mktime(time.strptime(s.replace("Z", "+0000"), "%Y-%m-%dT%H:%M:%S%z")) - time.timezone
    except (ValueError, AttributeError):
        return None


def supervision_notes(limit=30):
    path = FM / "state/branch-outcomes.jsonl"
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 60000))
            lines = f.read().decode("utf-8", "replace").splitlines()[-limit:]
    except OSError:
        return []
    notes = []
    for l in lines:
        try:
            r = json.loads(l)
        except ValueError:
            continue
        if r.get("summary") and r.get("epoch"):
            notes.append({"at": r["epoch"], "task": r.get("task"), "text": r["summary"][:500]})
    return notes


def firstmate_view(records, workers):
    target = fm_window()
    lines, busy, agent = screen(target) if target else ([], False, None)
    landed = []
    for r in records.values():
        if r.get("state") != "done":
            continue
        pr = r.get("pr_url")
        title, repo = title_of({"id": r.get("id")}, r)
        info = merge_info(pr) if pr and r.get("merged") else None
        landed.append({"id": r.get("id"), "title": title, "repo": repo, "pr": pr, "kind": r.get("kind"),
                       "verb": (r.get("completion") or {}).get("verb"), "date": (r.get("completion") or {}).get("date"),
                       "at": iso_epoch(info.get("mergedAt")) if info else None,
                       "by": ((info or {}).get("mergedBy") or {}).get("login"), "base": (info or {}).get("baseRefName"),
                       "head": (info or {}).get("headRefName"), "commit": ((info or {}).get("mergeCommit") or {}).get("oid")})
    landed.sort(key=lambda x: -(x["at"] or 0))
    names = {w["id"]: w["title"] for w in workers}
    names.update({x["id"]: x["title"] for x in landed})
    feed = [{"at": n["at"], "who": "firstmate", "kind": "note", "task": n["task"], "text": n["text"]} for n in supervision_notes()]
    for w in workers:
        for e in w.get("events") or []:
            if e.get("at"):
                feed.append({"at": e["at"], "who": w["id"], "kind": e["state"], "task": w["id"], "text": e["note"]})
    for x in landed:
        if x["at"] and x["pr"]:
            feed.append({"at": x["at"], "who": "firstmate", "kind": "merged", "task": x["id"],
                         "text": f"Merged PR #{x['pr'].rsplit('/', 1)[-1]} into {x['base'] or 'its base'}: {x['title']}"})
    for f in feed:
        f["title"] = names.get(f.get("task"), f.get("task"))
    feed.sort(key=lambda f: -f["at"])
    return {"target": target, "busy": busy, "agent": agent, "doing": doing_now(lines), "screen": lines[-160:],
            "landed": landed, "activity": feed[:60]}


# ---------------------------------------------------------------- lavish boards
LAVISH_STATE = Path(os.environ.get("LAVISH_AXI_STATE_DIR", HOME / ".lavish-axi")) / "state.json"


def lavish_sessions():
    try:
        data = json.loads(LAVISH_STATE.read_text())
    except (OSError, ValueError):
        return {}
    s = data.get("sessions") or {}
    items = s.values() if isinstance(s, dict) else s
    return {x.get("key"): x for x in items if isinstance(x, dict) and x.get("key") and x.get("file")}


def board_title(path):
    try:
        head = Path(path).read_text(errors="replace")[:6000]
    except OSError:
        return None
    m = re.search(r"<title[^>]*>(.*?)</title>", head, re.S | re.I)
    return re.sub(r"\s+", " ", m.group(1)).strip()[:120] if m else None


def boards(workers):
    """The Lavish plans live workers are putting to the owner: open sessions whose
    file lives in a worker's worktree or data folder and was written after that
    worker started. Every other Lavish session is left out."""
    out_ = []
    for key, s in lavish_sessions().items():
        f = s.get("file")
        try:
            mtime = os.path.getmtime(f)
        except OSError:
            continue
        owner, kind = None, "other"
        for w in workers:
            roots = [p for p in (w.get("worktree"), str(FM / "data" / (w.get("id") or "-"))) if p]
            if any(f.startswith(r.rstrip("/") + "/") for r in roots) and mtime >= (w.get("started") or 0):
                owner, kind = w, "worker"
                break
        if kind != "worker" or s.get("status") == "ended":
            continue  # only plans a live worker is putting to the owner
        where = Path(f.split("/.lavish/")[0]).name if "/.lavish/" in f else Path(f).parent.name
        out_.append({"key": key, "file": f, "name": Path(f).name, "status": s.get("status"), "url": s.get("url"),
                     "rev": s.get("artifact_revision"), "mtime": mtime, "title": board_title(f) or Path(f).stem,
                     "kind": kind, "owner_id": owner.get("id") if owner else None,
                     "owner": owner.get("title") if owner else ("firstmate" if kind == "firstmate" else where)})
    out_.sort(key=lambda b: -b["mtime"])
    return out_


def board_file(key, rel):
    s = lavish_sessions().get(key)
    if not s:
        return None
    main_file = Path(s["file"]).resolve()
    if not rel:
        return main_file
    target = (main_file.parent / rel).resolve()
    return target if str(target).startswith(str(main_file.parent) + "/") and target.is_file() else None


SHIM = r"""<script>(function(){
  function post(m){ try { parent.postMessage(Object.assign({ crewDeck: 1 }, m), "*"); } catch (e) {} }
  function describe(el){
    if (!el || !el.tagName) return null;
    var text = (el.innerText || el.textContent || "").trim().replace(/\s+/g, " ").slice(0, 240);
    var cls = (typeof el.className === "string" && el.className.trim()) ? "." + el.className.trim().split(/\s+/).slice(0, 2).join(".") : "";
    var wrap = el.closest && el.closest("section, article, form, [data-lavish-question]");
    var h = wrap && wrap.querySelector("h1,h2,h3,h4,legend");
    return { tag: el.tagName.toLowerCase(), selector: el.tagName.toLowerCase() + (el.id ? "#" + el.id : "") + cls, text: text, context: h ? h.textContent.trim().replace(/\s+/g, " ").slice(0, 120) : null };
  }
  window.lavish = {
    queuePrompt: function(text, opts){
      opts = opts || {};
      var key = opts.queueKey || null, el = opts.element || null;
      if (!key && el && el.closest) { var w = el.closest("[data-lavish-question]"); if (w) key = w.getAttribute("data-lavish-question"); }
      var data = null; try { data = opts.data ? JSON.parse(JSON.stringify(opts.data)) : null; } catch (e) {}
      post({ type: "queue", text: String(text || ""), tag: opts.tag || null, label: opts.text || null, data: data, queueKey: key, element: describe(el) });
      return true;
    },
    sendQueuedPrompts: function(){ post({ type: "send" }); return true; }
  };
  var css = document.createElement("style");
  css.textContent = "[data-cd-hover]{outline:2px dashed #c792ea!important;outline-offset:2px!important;cursor:crosshair!important}" +
    "[data-cd-mark]{outline:2px solid #c792ea!important;outline-offset:2px!important}" +
    ".cd-pin{position:absolute;z-index:2147483646;min-width:20px;height:20px;padding:0 6px;border-radius:10px;background:#c792ea;color:#0b1020;font:700 11px/20px system-ui,sans-serif;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.35);pointer-events:none}" +
    ".cd-pop{position:absolute;z-index:2147483647;width:320px;max-width:calc(100vw - 24px);background:#0f1724;color:#e6e9f5;border:1px solid #c792ea;border-radius:10px;padding:10px;box-shadow:0 12px 32px rgba(0,0,0,.45);font:13px/1.45 system-ui,sans-serif}" +
    ".cd-pop .cd-q{font-size:11.5px;color:#9aa3c7;border-left:2px solid #c792ea;padding-left:7px;margin-bottom:8px;max-height:3.2em;overflow:hidden}" +
    ".cd-pop textarea{width:100%;box-sizing:border-box;min-height:64px;resize:vertical;border-radius:7px;border:1px solid #2c3a57;background:#0a111d;color:#e6e9f5;padding:7px 9px;font:13px/1.45 system-ui,sans-serif;outline:none}" +
    ".cd-pop textarea:focus{border-color:#82aaff}" +
    ".cd-pop .cd-row{display:flex;gap:8px;justify-content:flex-end;align-items:center;margin-top:8px}" +
    ".cd-pop .cd-hint{margin-right:auto;font-size:11px;color:#7c86ad}" +
    ".cd-pop button{font:600 12px system-ui,sans-serif;border-radius:7px;padding:5px 12px;cursor:pointer;border:1px solid #2c3a57;background:transparent;color:#e6e9f5}" +
    ".cd-pop button.cd-add{background:#82aaff;border-color:#82aaff;color:#0b1020}";
  (document.head || document.documentElement).appendChild(css);
  var annotate = false, hover = null, pop = null, seq = 0, pins = {};
  function clearHover(){ if (hover) { hover.removeAttribute("data-cd-hover"); hover = null; } }
  function closePop(){ if (pop) { pop.remove(); pop = null; } }
  function place(node, el, below){
    var r = el.getBoundingClientRect(), x = r.left + window.scrollX, y = (below ? r.bottom + 8 : r.top - 10) + window.scrollY;
    node.style.left = Math.max(8, Math.min(x, window.scrollX + document.documentElement.clientWidth - node.offsetWidth - 12)) + "px";
    node.style.top = Math.max(8, y) + "px";
  }
  function pin(el, id){
    seq += 1; el.setAttribute("data-cd-mark", id);
    var b = document.createElement("span"); b.className = "cd-pin"; b.textContent = String(seq);
    document.body.appendChild(b);
    var r = el.getBoundingClientRect(); b.style.left = (r.right + window.scrollX - 10) + "px"; b.style.top = (r.top + window.scrollY - 10) + "px";
    pins[id] = { el: el, badge: b };
  }
  function openPop(el){
    closePop();
    var d = describe(el);
    pop = document.createElement("div"); pop.className = "cd-pop"; pop.setAttribute("data-cd-pop", "");
    var q = document.createElement("div"); q.className = "cd-q"; q.textContent = d.text || d.selector;
    var ta = document.createElement("textarea"); ta.placeholder = "Comment on this part…";
    var row = document.createElement("div"); row.className = "cd-row";
    var hint = document.createElement("span"); hint.className = "cd-hint"; hint.textContent = "Ctrl+Enter adds · Esc cancels";
    var cancel = document.createElement("button"); cancel.type = "button"; cancel.textContent = "Cancel";
    var add = document.createElement("button"); add.type = "button"; add.className = "cd-add"; add.textContent = "Add";
    row.append(hint, cancel, add); pop.append(q, ta, row); document.body.appendChild(pop);
    place(pop, el, true);
    var submit = function(){
      var t = ta.value.trim(); if (!t) { ta.focus(); return; }
      var id = "cd" + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
      pin(el, id); post({ type: "comment", text: t, element: d, markId: id }); closePop();
    };
    add.onclick = submit; cancel.onclick = closePop;
    ta.addEventListener("keydown", function(e){ if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) { e.preventDefault(); submit(); } if (e.key === "Escape") { e.preventDefault(); e.stopPropagation(); closePop(); } });
    setTimeout(function(){ ta.focus(); }, 0);
  }
  window.addEventListener("message", function(e){
    if (e.source !== parent) return;
    var d = e.data || {};
    if (!d.crewDeck) return;
    if (d.type === "annotate") { annotate = !!d.on; if (!annotate) { clearHover(); closePop(); } }
    if (d.type === "unmark" && pins[d.markId]) { pins[d.markId].el.removeAttribute("data-cd-mark"); pins[d.markId].badge.remove(); delete pins[d.markId]; }
  });
  var interactive = "input,select,textarea,button,label,a,summary,[role=button],[data-lavish-action],[data-cd-pop],.cd-pop";
  document.addEventListener("mouseover", function(e){
    if (!annotate || pop) return;
    var el = e.target; if (el.closest(interactive) || el === document.body || el === document.documentElement) { clearHover(); return; }
    if (hover !== el) { clearHover(); hover = el; el.setAttribute("data-cd-hover", ""); }
  }, true);
  document.addEventListener("click", function(e){
    if (!annotate) return;
    var el = e.target;
    if (el.closest("[data-cd-pop]")) return;
    if (pop) { e.preventDefault(); e.stopPropagation(); closePop(); return; }
    if (el.closest(interactive) || el === document.body || el === document.documentElement) return;
    e.preventDefault(); e.stopPropagation(); clearHover(); openPop(el);
  }, true);
  document.addEventListener("keydown", function(e){
    if (e.key !== "Escape" || !annotate) return;
    if (pop) { closePop(); return; }
    post({ type: "stop-annotate" });
  });
})();</script>"""


def inject_shim(html):
    m = re.search(rb"<head[^>]*>", html, re.I)
    at = m.end() if m else 0
    return html[:at] + SHIM.encode() + html[at:]


def board_thread_path(key):
    return RUN / "boards" / f"{key}.jsonl"


def board_thread(key):
    try:
        return [json.loads(l) for l in board_thread_path(key).read_text().splitlines() if l.strip()][-40:]
    except (OSError, ValueError):
        return []


def board_send(key, items):
    deck = cached_deck()
    b = next((x for x in deck.get("boards", []) if x["key"] == key), None)
    if not b or not b.get("owner_id"):
        return False, "that plan's worker is no longer running"
    lines = []
    for i, it in enumerate(items[:40], 1):
        kind = it.get("kind")
        if kind == "answer":
            q = it.get("queueKey") or (it.get("data") or {}).get("question") or "answer"
            lines.append(f"{i}. [answer · {q}] {it.get('text', '')}" + (f"\n   data: {json.dumps(it.get('data'))[:800]}" if it.get("data") else ""))
        elif kind == "comment":
            el = it.get("element") or {}
            where = (f" in \"{el.get('context')}\"" if el.get("context") else "")
            lines.append(f"{i}. [comment on {el.get('selector', 'an element')}{where}: \"{(el.get('text') or '')[:200]}\"] {it.get('text', '')}")
        elif kind == "question":
            lines.append(f"{i}. [question] {it.get('text', '')}")
    if not lines:
        return False, "nothing to send"
    msg = ("The captain's feedback on your Lavish plan board, sent from the crew deck, where the captain reviews your board. "
           "Treat it exactly as board feedback from Lavish: these are the captain's own words. Act on every item. Answer questions and "
           "show changes by updating the board itself (the deck reloads it on every revision) and keep it armed as before.\n\n" + "\n".join(lines))
    code, o = sh([str(FM / "bin/fm-send.sh"), b["owner_id"], msg], timeout=30, env=FM_ENV)
    if code != 0:
        return False, (o.strip().splitlines() or ["the message did not reach the worker"])[-1][:300]
    path = board_thread_path(key)
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a") as f:
        f.write(json.dumps({"at": time.time(), "to": b["owner_id"], "items": items[:40]}) + "\n")
    return True, b["owner_id"]


def board_open(key):
    s = lavish_sessions().get(key)
    if not s:
        return False, "that Lavish page is gone"
    code, o = sh(["lavish-axi", s["file"], "--no-open"], timeout=30)
    m = re.search(r"https?://127\.0\.0\.1:\d+/session/[0-9a-f]+", o)
    if code == 0 and m:
        return True, m.group(0)
    return False, (o.strip().splitlines() or ["Lavish would not open it"])[-1][:300]


# ---------------------------------------------------------------- chat
INBOX = str(FM / "bin/fm-inbox.sh")


def chat_thread():
    code, text = sh([INBOX, "receipts", "--all-pending", "--all-handled", "--all-replies"], timeout=15, env=FM_ENV)
    try:
        data = json.loads(text)
    except ValueError:
        return {"ok": False, "messages": []}
    msgs = []
    for n, handled in [(n, False) for n in data.get("pending", [])] + [(n, True) for n in data.get("handled", [])]:
        reply = n.get("reply")
        msgs.append({"id": n.get("id"), "at": n.get("at"), "body": n.get("body") or "", "rid": n.get("request_id") or "",
                     "state": "answered" if reply else ("seen" if handled or n.get("acknowledged") else "sent"),
                     "reply": {"at": reply.get("at"), "body": reply.get("body") or ""} if reply else None})
    msgs.sort(key=lambda m: str(m.get("at") or ""))
    return {"ok": True, "messages": msgs[-80:]}


def image_ok(data, ext):
    """The bytes must really be the image type the page claimed."""
    return {".png": data.startswith(b"\x89PNG\r\n\x1a\n"), ".jpg": data.startswith(b"\xff\xd8\xff"),
            ".gif": data[:6] in (b"GIF87a", b"GIF89a"), ".webp": data[:4] == b"RIFF" and data[8:12] == b"WEBP"}[ext]


def save_images(images):
    """Store pasted images where firstmate can read them; return their paths or an error."""
    if not isinstance(images, list) or len(images) > MAX_IMAGES:
        return None, f"attach at most {MAX_IMAGES} images"
    saved = []
    for img in images:
        if not isinstance(img, dict):
            return None, "bad image"
        ext = IMAGE_TYPES.get(str(img.get("type") or ""))
        if not ext:
            return None, "only PNG, JPEG, WebP and GIF images can be attached"
        try:
            data = base64.b64decode(str(img.get("data") or ""), validate=True)
        except ValueError:
            return None, "an image could not be read"
        if not data or len(data) > MAX_IMAGE_BYTES:
            return None, f"each image must be under {MAX_IMAGE_BYTES // (1024 * 1024)} MB"
        if not image_ok(data, ext):
            return None, "an attachment is not the image it claims to be"
        saved.append((data, ext))
    UPLOADS.mkdir(parents=True, exist_ok=True)
    os.chmod(UPLOADS, 0o700)
    paths = []
    for data, ext in saved:
        f = UPLOADS / (time.strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:8] + ext)
        fd = os.open(f, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "wb") as out:
            out.write(data)
        paths.append(str(f))
    return paths, None


def chat_send(text, rid):
    code, o = sh([INBOX, "note", "--request-id", rid, "--json", "-"], timeout=20, env=FM_ENV, stdin=text)
    try:
        res = json.loads(o)
    except ValueError:
        res = {}
    if code == 3 and res.get("id"):
        sh([INBOX, "announce", "--json", res["id"]], timeout=20, env=FM_ENV)
        code = 0
    return code == 0, res


# ---------------------------------------------------------------- server
class Handler(BaseHTTPRequestHandler):
    def _send(self, code, body, ctype):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def _json(self, code, obj):
        self._send(code, json.dumps(obj), "application/json")

    def _host_ok(self):
        if self.headers.get("Host") in HOSTS:
            return True
        self._send(403, "forbidden", "text/plain")
        return False

    def do_GET(self):
        if not self._host_ok():
            return
        path = self.path.split("?", 1)[0]
        if path == "/":
            self._send(200, PAGE, "text/html; charset=utf-8")
        elif path == "/api/deck":
            self._json(200, cached_deck())
        elif path == "/api/chat":
            self._json(200, chat_thread())
        elif re.fullmatch(r"/api/board/[0-9a-f]+/thread", path):
            self._json(200, {"thread": board_thread(path.split("/")[3])})
        elif path == "/api/ping":
            self._json(200, {"app": "crew-deck"})
        elif path.startswith("/upload/") and UPLOAD_NAME.fullmatch(path[8:]):
            try:
                data = (UPLOADS / path[8:]).read_bytes()
            except OSError:
                return self._send(404, "not found", "text/plain")
            ctype = {"png": "image/png", "jpg": "image/jpeg", "webp": "image/webp", "gif": "image/gif"}[path.rsplit(".", 1)[1]]
            self._send(200, data, ctype)
        elif path.startswith("/board/"):
            parts = path.split("/", 3)
            key = re.sub(r"[^0-9a-f]", "", parts[2] if len(parts) > 2 else "")
            rel = urllib.parse.unquote(parts[3]) if len(parts) > 3 else ""
            f = board_file(key, rel)
            if not f:
                return self._send(404, "not found", "text/plain")
            try:
                data = f.read_bytes()
            except OSError:
                return self._send(404, "not found", "text/plain")
            ctype = mimetypes.guess_type(str(f))[0] or "application/octet-stream"
            if not rel and ctype == "text/html":
                data = inject_shim(data)
            if ctype.startswith("text/") or ctype.endswith(("javascript", "json", "svg+xml")):
                ctype += "; charset=utf-8"
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Cache-Control", "no-store")
            # Served pages run with an opaque origin, so their scripts can never call this server's API.
            self.send_header("Content-Security-Policy", "sandbox allow-scripts allow-popups allow-forms allow-modals")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
        else:
            self._send(404, "not found", "text/plain")

    def do_POST(self):
        if not self._host_ok():
            return
        if self.headers.get("X-Crew-Deck") != "1" \
                or not (self.headers.get("Content-Type") or "").startswith("application/json"):
            return self._send(403, "forbidden", "text/plain")
        origin = self.headers.get("Origin")
        if origin and origin.split("://", 1)[-1] not in HOSTS:
            return self._send(403, "forbidden", "text/plain")
        m = re.fullmatch(r"/api/board/([0-9a-f]+)/send", self.path)
        if m:
            try:
                length = int(self.headers.get("Content-Length") or 0)
                items = json.loads(self.rfile.read(min(length, 256000)) or b"{}").get("items") or []
                items = [i for i in items if isinstance(i, dict)]
            except (ValueError, AttributeError):
                return self._json(400, {"ok": False, "error": "bad request"})
            ok, res = board_send(m.group(1), items)
            return self._json(200 if ok else 409, {"ok": ok, "to": res if ok else None, "error": None if ok else res})
        m = re.fullmatch(r"/api/board/([0-9a-f]+)/open", self.path)
        if m:
            ok, res = board_open(m.group(1))
            return self._json(200 if ok else 409, {"ok": ok, "url": res if ok else None, "error": None if ok else res})
        if self.path == "/api/decide":
            return self._decide()
        if self.path != "/api/chat":
            return self._send(404, "not found", "text/plain")
        try:
            length = int(self.headers.get("Content-Length") or 0)
            if length > MAX_IMAGES * MAX_IMAGE_BYTES * 4 // 3 + 64000:
                return self._json(413, {"ok": False, "error": "the attachments are too large"})
            body = json.loads(self.rfile.read(length) or b"{}")
            text = str(body.get("text") or "").strip()
            images = body.get("images") or []
            rid = re.sub(r"[^A-Za-z0-9-]", "", str(body.get("rid") or ""))[:64] or str(uuid.uuid4())
        except (ValueError, AttributeError):
            return self._json(400, {"ok": False, "error": "bad request"})
        if not text and not images:
            return self._json(400, {"ok": False, "error": "empty message"})
        if len(text) > MAX_MESSAGE:
            return self._json(400, {"ok": False, "error": f"message is longer than {MAX_MESSAGE} characters"})
        if images:
            paths, err = save_images(images)
            if err:
                return self._json(400, {"ok": False, "error": err})
            word = "image" if len(paths) == 1 else f"{len(paths)} images"
            text = (text + "\n\n" if text else "") + f"[Attached {word} from the crew deck; open each file to see it:]\n" \
                + "\n".join(paths)
        ok, res = chat_send(text, "crew-deck-" + rid)
        self._json(200 if ok else 500, {"ok": ok, "note": res})

    def _decide(self):
        """Turn a click in the deck into a message to firstmate's inbox; firstmate
        records the decision and acts on it. The deck itself changes nothing."""
        try:
            length = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(min(length, 64000)) or b"{}")
        except ValueError:
            return self._json(400, {"ok": False, "error": "bad request"})
        deck = cached_deck()
        task = str(body.get("task") or "")
        note = str(body.get("note") or "").strip()[:MAX_MESSAGE]
        rid = re.sub(r"[^A-Za-z0-9-]", "", str(body.get("rid") or ""))[:64] or str(uuid.uuid4())
        if body.get("kind") == "call":
            item = next((w for w in deck.get("waiting", []) if w["id"] == task), None)
            opts = {o.get("id"): o for o in ((item or {}).get("call") or {}).get("options", [])}
            opt = opts.get(str(body.get("option")))
            if not item or (not opt and not note):
                return self._json(400, {"ok": False, "error": "that decision is no longer open"})
            text = f"Decision from the crew deck for {task} ({item['title']}): "
            text += f"option {opt['id']}, {opt.get('label', '')}." if opt else "no listed option."
            if note:
                text += f" My note: {note}"
        elif body.get("kind") == "merge":
            item = next((r for r in deck.get("ready", []) if r["id"] == task), None)
            if not item:
                return self._json(400, {"ok": False, "error": "that PR is no longer waiting"})
            if body.get("option") == "merge":
                text = f"From the crew deck: merge {item['pr']} ({item['title']}) into {item.get('base') or 'its base branch'}."
            else:
                text = f"From the crew deck: do not merge {item['pr']} ({item['title']}) yet."
            if note:
                text += f" My note: {note}"
        else:
            return self._json(400, {"ok": False, "error": "unknown decision"})
        ok, res = chat_send(text, "crew-deck-decide-" + rid)
        self._json(200 if ok else 500, {"ok": ok, "note": res, "text": text})

    def log_message(self, *args):
        pass


def serve():
    RUN.mkdir(parents=True, exist_ok=True)
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    PIDFILE.write_text(str(os.getpid()))
    signal.signal(signal.SIGTERM, lambda *_: (srv.server_close(), sys.exit(0)))
    try:
        srv.serve_forever()
    finally:
        try:
            if PIDFILE.read_text().strip() == str(os.getpid()):
                PIDFILE.unlink()
        except OSError:
            pass


def alive():
    try:
        with urllib.request.urlopen(URL + "api/ping", timeout=1) as r:
            return json.load(r).get("app") == "crew-deck"
    except Exception:
        return False


def start_background():
    RUN.mkdir(parents=True, exist_ok=True)
    log = open(RUN / "server.log", "ab")
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "serve"], stdin=subprocess.DEVNULL,
                     stdout=log, stderr=log, start_new_session=True, close_fds=True)
    for _ in range(50):
        if alive():
            return True
        time.sleep(0.1)
    return False


def stop():
    try:
        pid = int(PIDFILE.read_text().strip())
        if b"crew-deck" not in Path(f"/proc/{pid}/cmdline").read_bytes():
            raise ValueError
    except (OSError, ValueError):
        print("crew-deck: no server running")
        return False
    os.kill(pid, signal.SIGTERM)
    for _ in range(30):
        if not Path(f"/proc/{pid}").exists():
            break
        time.sleep(0.1)
    print(f"crew-deck: stopped server {pid}")
    return True


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg in ("-h", "--help"):
        print(__doc__.strip())
    elif arg == "serve":
        serve()
    elif arg == "stop":
        stop()
    elif arg == "restart":
        stop()
        if not start_background():
            sys.exit(f"crew-deck: the server did not start; see {RUN / 'server.log'}")
        print(URL)
    elif arg == "--json":
        print(json.dumps(build(), indent=1))
    elif arg == "":
        if not alive() and not start_background():
            sys.exit(f"crew-deck: the server did not start; see {RUN / 'server.log'}")
        opener = "browser-here" if out(["sh", "-c", "command -v browser-here"]).strip() else "xdg-open"
        subprocess.Popen([opener, URL], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        print(URL)
    else:
        sys.exit(f"crew-deck: unknown argument {arg!r}; see crew-deck --help")


PAGE = r"""<!doctype html>
