#!/usr/bin/env python3
"""Write the herdr guide for the bar's search guides (Quick Reference Guide).

Reads herdr's resolved keys from `omarchy-menu-herdr-keybindings --print`
(herdr's defaults with ~/.config/herdr/config.toml on top), sorts them into
sections and writes ~/.config/qrg/guides/herdr.txt, which Super+Ctrl+/ opens.

    qrg-herdr-guide            write the guide
    qrg-herdr-guide --stdout   print it instead

Run by the post-boot hook, and after any change to herdr's keys.
"""

import os
import re
import subprocess
import sys

OUT = os.path.join(os.path.expanduser("~"), ".config/qrg/guides/herdr.txt")

# (section, description pattern), first match wins; order is the guide's order.
SECTIONS = [
    ("Prefix and help", r"^(PREFIX|Help|Settings|Detach|Reload config|Open notification target|Goto|Copy mode|Edit scrollback|Remote image paste)$"),
    ("Workspaces", r"[Ww]orkspace|worktree"),
    ("Tabs", r"[Tt]ab\b"),
    ("Panes", r"[Pp]ane|Split|Zoom|Resize|Toggle sidebar"),
    ("Navigate mode", r".*"),
]

NAMES = {"CTRL": "Ctrl", "ALT": "Alt", "SHIFT": "Shift", "SPACE": "Space", "ENTER": "Enter", "ESC": "Esc",
         "TAB": "Tab", "LEFT": "Left", "RIGHT": "Right", "UP": "Up", "DOWN": "Down", "PREFIX": "Prefix",
         "NAVIGATE": "Navigate"}


def pretty(chord):
    """'CTRL + ALT + H' -> 'Ctrl+Alt+H'; 'PREFIX + V' -> 'Prefix V' (a second step)."""
    parts = [NAMES.get(p, p) for p in re.split(r"\s*\+\s*", chord.strip())]
    # The prefix is a separate press, not held with the next key.
    if parts and parts[0] in ("Prefix", "Navigate"):
        head, rest = parts[0], "+".join(parts[1:])
        return f"{head} {rest}".strip()
    return "+".join(parts)


def rows():
    out = subprocess.run(["omarchy-menu-herdr-keybindings", "--print"], capture_output=True, text=True, check=True).stdout
    for line in out.splitlines():
        if "→" not in line:
            continue
        keys, desc = (p.strip() for p in line.split("→", 1))
        if keys and desc:
            yield keys, desc


def render():
    lines = [
        "# herdr",
        "This setup's herdr: prefix Ctrl+Space, Alt and Ctrl+Alt keys that need no prefix",
        "// Generated by ~/.local/bin/qrg-herdr-guide from herdr's resolved keys",
        "// (omarchy-menu-herdr-keybindings --print). Do not edit by hand; re-run it.",
        "// \"Prefix\" means press Ctrl+Space, let go, then the key.",
        "",
    ]
    by = {}
    for keys, desc in rows():
        chords = " / ".join(pretty(c) for c in keys.split(" / "))
        if desc.startswith("CTRL + SPACE") or keys == "PREFIX":
            chords, desc = "Ctrl+Space", "The prefix key"
        section = next(name for name, pat in SECTIONS if re.search(pat, desc if keys != "PREFIX" else "PREFIX") or re.search(pat, desc))
        by.setdefault(section, []).append((chords, desc))
    for name, _ in SECTIONS:
        if name not in by:
            continue
        tag = "#" + re.sub(r"[^a-z]+", "", name.split()[0].lower())
        lines.append(f"## {name}")
        lines += [f"{k} | {d} | {tag}" for k, d in by[name]]
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def main():
    guide = render()
    if "--stdout" in sys.argv:
        sys.stdout.write(guide)
        return
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    tmp = OUT + ".tmp"
    with open(tmp, "w") as f:
        f.write(guide)
    os.replace(tmp, OUT)


if __name__ == "__main__":
    main()
