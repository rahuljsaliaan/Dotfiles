#!/usr/bin/env python3
"""Write the Hyprland guide for the bar's search guides (Quick Reference Guide).

Reads the live bindings from `omarchy menu keybindings --print`, sorts them
into sections, folds numbered runs (Super+1 ... Super+0) into one line, merges
keys that do the same thing, and marks the bindings this setup adds (the ones
in ~/.config/hypr/bindings.lua) with [Y]. Plugin-internal mouse hooks are left
out. The result goes to ~/.config/qrg/guides/hyprland.txt.

    qrg-hyprland-guide            write the guide
    qrg-hyprland-guide --stdout   print it instead

Run by the post-boot hook, and after any change to the bindings.
"""

import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
USER_BINDINGS = os.path.join(HOME, ".config/hypr/bindings.lua")
OUT = os.path.join(HOME, ".config/qrg/guides/hyprland.txt")

# Bindings that are plumbing rather than keys to remember.
SKIP = [r"^Omapop ", r"^Direct input for the terminal prefix$"]

# (section, description pattern), first match wins; order is the guide's order.
SECTIONS = [
    ("Essentials", r"^(Keybindings|Omarchy menu|Terminal|Browser|File manager|System menu|Apps|Close window|Close all windows|Lock system|Full screen|Toggle top bar|Agent|Tmux|Power menu)$"),
    ("Hyprpin (windows that follow you)", r"Hyprpin"),
    ("Nav mode (Super+; then H/J/K/L)", r"^Nav mode"),
    ("Windows", r"window|Window|Full width|Pop |Tiled full screen|transparency|gaps|square aspect|Minimize"),
    ("Groups (tabbed windows)", r"group"),
    ("Workspaces", r"workspace|scratchpad|Quake console|layout"),
    ("Monitors", r"monitor|Monitor|display|Display|mirroring|full screen desktop"),
    ("Screenshots, recording and zoom", r"Screenshot|Screenrecording|Color picker|Capture menu|OCR|Share|Transcode|Zoom|zoom|webcam|Download Video|Copy URL"),
    ("Clipboard and text", r"Universal|Clipboard|Emojis|Select all"),
    ("Notifications and reminders", r"otification|Dismiss|eminder"),
    ("Bar panels and menus", r"Bar panel|^Audio$|^Bluetooth$|^Network$|^Power$|Calendar$|World clock|weather|Show time|battery|Hardware menu|Theme menu|Background switcher|Toggle menu|locking on idle|keybindings"),
    ("Sound, media, brightness and input", r"Volume|Mute|[Tt]rack|^Play$|^Pause$|[Bb]rightness|backlight|media source|audio output|[Tt]ouchpad|Eject|dictation|Superwhisper|input language"),
    ("Apps", r".*"),
]

KEY_NAMES = {
    "SUPER": "Super", "SHIFT": "Shift", "CTRL": "Ctrl", "ALT": "Alt",
    "RETURN": "Enter", "ESCAPE": "Esc", "Escape": "Esc", "SPACE": "Space", "space": "Space",
    "TAB": "Tab", "BACKSPACE": "Backspace", "DELETE": "Delete", "Delete": "Delete",
    "COMMA": ",", "PERIOD": ".", "SLASH": "/", "BACKSLASH": "\\", "SEMICOLON": ";",
    "MINUS": "-", "EQUAL": "=", "BRACKETLEFT": "[", "BRACKETRIGHT": "]", "~": "`",
    "LEFT": "Left", "RIGHT": "Right", "UP": "Up", "DOWN": "Down", "PRINT": "Print",
    "Home": "Home", "LEFT MOUSE BUTTON": "Left-drag", "RIGHT MOUSE BUTTON": "Right-drag",
    "mouse_down": "Scroll down", "mouse_up": "Scroll up", "Alt_R": "Right Alt",
}


def pretty(keys):
    """'SUPER SHIFT + B' -> 'Super+Shift+B'; keeps ' / ' alternatives."""
    out = []
    for alt in keys.split(" / "):
        if " + " in alt:
            mods, key = alt.rsplit(" + ", 1)
            parts = mods.split() + [key]
        else:
            parts = [alt]
        out.append("+".join(KEY_NAMES.get(p, p if len(p) > 1 and not p.isupper() else p.capitalize() if len(p) > 1 else p) for p in parts))
    return " / ".join(out)


def norm(keys):
    """A comparable form: modifiers as a sorted set, then the key."""
    keys = keys.strip()
    if " + " in keys or "+" in keys:
        parts = [p.strip() for p in re.split(r"\s*\+\s*|\s+", keys) if p.strip()]
        mods, key = parts[:-1], parts[-1]
    else:
        mods, key = [], keys
    return " ".join(sorted(m.upper() for m in mods)) + "|" + key.upper()


def user_keys():
    """Keys bound in ~/.config/hypr/bindings.lua, loops expanded."""
    try:
        text = open(USER_BINDINGS).read()
    except OSError:
        return set()
    text = "\n".join(line for line in text.splitlines() if not line.strip().startswith("--"))
    loop_keys = re.findall(r'key\s*=\s*"([^"]+)"', text)
    # (key, description start) pairs: a key only counts as this setup's own
    # when its description comes from this file too, since stock bindings
    # share keys with it (Esc, for one).
    found = set()
    desc = r'\s*,\s*"([^"]*)"'
    for literal, text_desc in re.findall(r'o\.(?:re)?bind\(\s*"([^"]+)"' + desc, text):
        found.add((norm(literal), text_desc))
    for prefix, text_desc in re.findall(r'o\.(?:re)?bind\(\s*"([^"]*)"\s*\.\.\s*d\.key' + desc, text):
        for key in loop_keys:
            found.add((norm(prefix + key), text_desc))
    for text_desc in re.findall(r"o\.(?:re)?bind\(\s*d\.key" + desc, text):
        for key in loop_keys:
            found.add((norm(key), text_desc))
    return found


def is_mine(keys, desc, mine):
    return any(norm(k) == key and desc.startswith(start)
               for k in keys.split(" / ") for key, start in mine)


def read_bindings():
    out = subprocess.run(["omarchy", "menu", "keybindings", "--print"], capture_output=True, text=True, check=True).stdout
    rows = []
    for line in out.splitlines():
        if "→" not in line:
            continue
        keys, desc = (part.strip() for part in line.split("→", 1))
        if keys and desc and not any(re.search(p, desc) for p in SKIP):
            rows.append((keys, desc))
    return rows


def fold(rows, mine):
    """Merge numbered runs and same-description keys; keep first-seen order."""
    entries, by_desc = [], {}
    for keys, desc in rows:
        number = re.match(r"^(.*?)(\d+)$", desc)
        key_number = re.match(r"^(.* \+ )(\d)$", keys)
        if number and key_number:
            desc_key = ("run", number.group(1), key_number.group(1))
        else:
            desc_key = ("same", desc)
        mine_here = is_mine(keys, desc, mine)
        if desc_key in by_desc:
            entry = by_desc[desc_key]
            entry["keys"].append(keys)
            entry["mine"] = entry["mine"] or mine_here
            if number:
                entry["numbers"].append(int(number.group(2)))
            continue
        entry = {"keys": [keys], "desc": desc, "mine": mine_here,
                 "run": desc_key[0] == "run", "numbers": [int(number.group(2))] if number and key_number else []}
        by_desc[desc_key] = entry
        entries.append(entry)
    for entry in entries:
        if entry["run"] and len(entry["keys"]) > 1:
            prefix = entry["keys"][0].rsplit(" + ", 1)[0]
            digits = sorted(int(k.rsplit(" + ", 1)[1]) for k in entry["keys"])
            last = "0" if 0 in digits else str(max(digits))
            first = str(min(d for d in digits if d) if any(digits) else 0)
            entry["keys"] = [f"{prefix} + {first}…{last}"]
            low, high = min(entry["numbers"]), max(entry["numbers"])
            entry["desc"] = re.sub(r"\d+$", f"{low}–{high}", entry["desc"])
    return entries


# Sections whose words also appear in "Windows" descriptions ("Move window to
# workspace 3", "... to left monitor", "... to group") are matched first.
MATCH_FIRST = ["Essentials", "Hyprpin (windows that follow you)", "Nav mode (Super+; then H/J/K/L)",
               "Groups (tabbed windows)", "Workspaces", "Monitors"]


def section_of(desc):
    patterns = dict(SECTIONS)
    order = MATCH_FIRST + [name for name, _ in SECTIONS if name not in MATCH_FIRST]
    for name in order:
        if re.search(patterns[name], desc):
            return name
    return SECTIONS[-1][0]


def render(entries):
    lines = [
        "# Hyprland",
        "This desktop's keys: Omarchy's defaults plus this setup's own (marked Y)",
        "@legend Y=This setup's own",
        "// Generated by ~/.local/bin/qrg-hyprland-guide from the live bindings",
        "// (omarchy menu keybindings --print). Do not edit by hand; re-run it.",
        "",
        "## What Super means",
        "Super | The Windows key: every desktop shortcut starts with it | Super+Enter = hold the Windows key, press Enter | #super #what #help",
        "Super+K | Every key on this desktop, searchable | The full list this guide is made from | #help #keys",
        "Fn+Super | Locks or unlocks the Super key on this keyboard | If Super shortcuts stop working, press Fn+Super once | #super #lock #keyboard",
        "",
    ]
    by_section = {}
    for entry in entries:
        by_section.setdefault(section_of(entry["desc"]), []).append(entry)
    for name, _ in SECTIONS:
        items = by_section.get(name)
        if not items:
            continue
        lines.append(f"## {name}")
        for entry in items:
            keys = pretty(" / ".join(entry["keys"])).replace("|", "¦")
            desc = entry["desc"].replace("|", "¦")
            mark = "[Y] " if entry["mine"] else ""
            tag = "#" + re.sub(r"[^a-z]+", "", name.split()[0].lower())
            lines.append(f"{mark}{keys} | {desc} | {tag}")
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def main():
    guide = render(fold(read_bindings(), user_keys()))
    if "--stdout" in sys.argv:
        sys.stdout.write(guide)
        return
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    tmp = OUT + ".tmp"
    with open(tmp, "w") as f:
        f.write(guide)
    os.replace(tmp, OUT)


if __name__ == "__main__":
    main()
